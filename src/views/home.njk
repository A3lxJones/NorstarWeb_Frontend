{% extends "layouts/base.njk" %}

{% block content %}

<!-- ═══════════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════════ -->
<section class="relative border-b border-base-300 bg-base-100">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl py-16 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Copy -->
      <div class="lg:col-span-7 scroll-reveal opacity-0">
        <span class="eyebrow mb-6 block">Ballymena Inline Hockey Club &middot; Est. 2023</span>
        <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] mb-6 text-base-content">
          <span class="text-secondary">NOR</span>STAR
          <span class="block text-2xl md:text-3xl lg:text-4xl font-medium text-base-content/60 mt-3 tracking-normal">
            Developing inline hockey players from first strides to competitive play.
          </span>
        </h1>

        <p class="text-base md:text-lg text-base-content/70 leading-relaxed max-w-xl mb-8">
          Junior U12/U14 and Learn to Skate programmes — run every Saturday at Ballymena North Centre by qualified coaches in a friendly, family environment.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/contact" class="btn btn-secondary gap-2">
            Join the club
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          {% if isLoggedIn %}
          <a href="/fixtures" class="btn btn-outline">
            View fixtures
          </a>
          {% endif %}
        </div>
      </div>

      <!-- Logo / image -->
      <div class="lg:col-span-5 scroll-reveal opacity-0" style="--animation-delay: 0.1s;">
        <div class="relative aspect-square max-w-md mx-auto">
          <img src="/images/Norstar.png" alt="Norstar Inline Hockey Club Logo" class="relative w-full h-full object-contain p-8" />
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════════════
     PROGRAMMES
     ═══════════════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-24 bg-base-200/60">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
    <!-- Heading -->
    <div class="max-w-2xl mb-12">
      <span class="eyebrow mb-3 block">Our Programmes</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold mb-3">Find your level</h2>
      <p class="text-base-content/60">
        Whether you're lacing up for the first time or chasing silverware, we have a programme for you.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {% for program in programs %}
      <article class="scroll-reveal opacity-0 group bg-base-100 border border-base-300 rounded-box overflow-hidden hover:border-secondary/40 transition-colors duration-200" style="--animation-delay: {{ loop.index0 * 0.1 }}s;">
        <figure class="aspect-[4/3] bg-base-200 overflow-hidden">
          {% if loop.index0 == 0 %}
            <img src="/images/NorstarTeams.png" alt="{{ program.name }} programme image" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy" />
          {% elif loop.index0 == 1 %}
            <img src="/images/NorstarTeams3.png" alt="{{ program.name }} programme image" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy" />
          {% else %}
            <img src="/images/NortstarTeams2.png" alt="{{ program.name }} programme image" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy" />
          {% endif %}
        </figure>
        <div class="p-6">
          <h3 class="font-heading text-xl font-bold mb-2 text-base-content">
            {{ program.name }}
          </h3>
          <p class="text-base-content/65 leading-relaxed text-sm mb-4">
            {{ program.description }}
          </p>
          <a href="/contact" class="text-sm font-semibold text-secondary inline-flex items-center gap-1 hover:gap-2 transition-all duration-200">
            Learn more
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════════════
     STATS BAND
     ═══════════════════════════════════════════════════════════════ -->
<section class="bg-primary text-primary-content">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl py-14">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center md:text-left">
      <div class="scroll-reveal opacity-0">
        <div class="text-3xl md:text-4xl font-heading font-bold counter" data-target="50">0</div>
        <div class="text-xs uppercase tracking-[0.18em] text-primary-content/60 mt-2">Active Players</div>
      </div>
      <div class="scroll-reveal opacity-0" style="--animation-delay: 0.1s;">
        <div class="text-3xl md:text-4xl font-heading font-bold counter" data-target="3">0</div>
        <div class="text-xs uppercase tracking-[0.18em] text-primary-content/60 mt-2">Programmes</div>
      </div>
      <div class="scroll-reveal opacity-0" style="--animation-delay: 0.2s;">
        <div class="text-3xl md:text-4xl font-heading font-bold counter" data-target="8">0</div>
        <div class="text-xs uppercase tracking-[0.18em] text-primary-content/60 mt-2">Coaches</div>
      </div>
      <div class="scroll-reveal opacity-0" style="--animation-delay: 0.3s;">
        <div class="text-3xl md:text-4xl font-heading font-bold counter" data-target="2023">0</div>
        <div class="text-xs uppercase tracking-[0.18em] text-primary-content/60 mt-2">Established</div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════════════
     ABOUT
     ═══════════════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-28 bg-base-100">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <div class="scroll-reveal opacity-0 order-2 lg:order-1">
        <div class="aspect-[4/3] rounded-box overflow-hidden bg-base-200 border border-base-300">
          <img src="/images/NorstarTeam4.png" alt="Norstar team photo" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>

      <div class="scroll-reveal opacity-0 order-1 lg:order-2" style="--animation-delay: 0.1s;">
        <span class="eyebrow mb-3 block">About the Club</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold mb-5">
          Who are <span class="text-secondary">Norstar</span>?
        </h2>
        <p class="text-base-content/70 leading-relaxed mb-4">
          Founded in 2023, Norstar Inline Hockey Club is Ballymena's first dedicated inline hockey club. We're passionate about growing the sport in Northern Ireland and providing a welcoming environment for players of all abilities.
        </p>
        <p class="text-base-content/70 leading-relaxed mb-8">
          From beginners taking their first strides to our competitive Junior U12/U14 squad, we offer structured programmes led by experienced coaches. Our home rink at Ballymena North Centre is where the magic happens — every Saturday.
        </p>

        <ul class="grid grid-cols-2 gap-x-4 gap-y-3 mb-8 text-sm">
          <li class="flex items-center gap-2 text-base-content/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            Qualified coaches
          </li>
          <li class="flex items-center gap-2 text-base-content/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            All ages welcome
          </li>
          <li class="flex items-center gap-2 text-base-content/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            Equipment provided
          </li>
          <li class="flex items-center gap-2 text-base-content/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            Family-friendly
          </li>
        </ul>

        <a href="/contact" class="btn btn-secondary gap-2">
          Learn more about us
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════════════
     LATEST NEWS
     ═══════════════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-24 bg-base-200/60 border-y border-base-300">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
      <div>
        <span class="eyebrow mb-3 block">Stay Updated</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold">Latest news</h2>
      </div>
      <a href="/news" class="text-sm font-semibold text-secondary inline-flex items-center gap-1 hover:gap-2 transition-all duration-200">
        View all news
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

<!-- ═══════════════════════════════════════════════════════════════
     CALL TO ACTION
     ═══════════════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-24 bg-base-100">
  <div class="container mx-auto px-4 lg:px-8 max-w-4xl text-center">
    <h2 class="scroll-reveal opacity-0 font-heading text-3xl md:text-4xl font-bold mb-4">
      Ready to hit the <span class="text-accent">rink</span>?
    </h2>
    <p class="scroll-reveal opacity-0 text-base-content/65 max-w-2xl mx-auto mb-8">
      Whether you're a complete beginner or looking to join our competitive squad, we'd love to hear from you. Get in touch and start your inline hockey journey today.
    </p>
    <div class="scroll-reveal opacity-0 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/contact" class="btn btn-secondary gap-2">
        Get in touch
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>
      <a href="https://shop.norstarinline.com" target="_blank" rel="noopener noreferrer" class="btn btn-outline gap-2">
        Visit shop
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</section>

{% endblock %}
