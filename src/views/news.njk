{% extends "layouts/base.njk" %}

{% block content %}

<!-- Page Header -->
<section class="py-16 lg:py-20 bg-base-200/50 border-b border-base-300/50 relative overflow-hidden">
  <div class="absolute bottom-10 left-10 w-72 h-72 bg-accent/5 rounded-full blur-3xl"></div>
  <div class="container mx-auto px-4 max-w-6xl text-center relative z-10">
    <span class="scroll-reveal opacity-0 badge badge-secondary badge-outline badge-sm font-medium tracking-wider uppercase mb-4">Club Updates</span>
    <h1 class="scroll-reveal opacity-0 font-heading text-4xl md:text-6xl font-bold mb-4">
      Latest <span class="text-secondary">News</span>
    </h1>
    <p class="scroll-reveal opacity-0 text-base-content/60 max-w-lg mx-auto">
      All the latest from Norstar Inline Hockey Club.
    </p>
  </div>
</section>

<!-- Featured Article -->
<section class="py-16 lg:py-20">
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">

    <div class="scroll-reveal opacity-0 card bg-base-200 border border-base-300 shadow-xl overflow-hidden group lg:card-side">
      <!-- Image placeholder -->
      <figure class="lg:w-2/5 bg-gradient-to-br from-secondary/20 via-accent/10 to-primary/20 flex items-center justify-center min-h-[240px] relative">
        <div class="text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-secondary/30 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          <p class="text-xs text-base-content/30 mt-2">Featured image placeholder</p>
        </div>
        <div class="absolute top-4 left-4">
          <span class="badge badge-secondary font-medium">Featured</span>
        </div>
      </figure>
      <div class="card-body lg:w-3/5 p-8">
        <div class="flex items-center gap-3 text-sm text-base-content/50 mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          10 February 2026
          <span class="badge badge-secondary badge-xs">Registration</span>
        </div>
        <h2 class="card-title font-heading text-2xl md:text-3xl group-hover:text-secondary transition-colors">
          Season Registration Now Open
        </h2>
        <p class="text-base-content/70 leading-relaxed mt-2">
          Registration for the upcoming spring season is now open! Whether you're returning or joining for the first time,
          head to our registration page to secure your spot. Early bird discounts are available until the end of February.
          We have places across all three programmes — Junior U13, Learn to Play, and Learn to Skate.
        </p>
        <div class="card-actions mt-4">
          <a href="#" class="btn btn-secondary btn-sm gap-1">
            Read Full Article
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- News Grid + Sidebar -->
<section class="py-8 lg:py-12">
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

      <!-- Articles column -->
      <div class="lg:col-span-2 space-y-8">

        <article class="scroll-reveal opacity-0 card bg-base-200 border border-base-300 shadow-lg hover:border-secondary/30 transition-all duration-300 group">
          <!-- Article image placeholder -->
          <figure class="bg-gradient-to-br from-accent/10 via-base-300/50 to-secondary/10 flex items-center justify-center h-48 relative">
            <div class="text-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-accent/20 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              <p class="text-[10px] text-base-content/20 mt-1">Article image</p>
            </div>
          </figure>
          <div class="h-1 bg-gradient-to-r from-accent to-secondary"></div>
          <div class="card-body">
            <div class="flex items-center gap-3 text-sm text-base-content/50 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              05 February 2026
              <span class="badge badge-accent badge-xs">Results</span>
            </div>
            <h2 class="card-title font-heading text-2xl group-hover:text-secondary transition-colors">
              U13s Win Regional Cup
            </h2>
            <p class="text-base-content/70 leading-relaxed">
              Our Junior U13 team claimed a fantastic victory at the regional cup tournament! The team showed excellent
              discipline and teamwork throughout the competition, securing a 5-2 win in the final against Belfast Blades.
            </p>
            <div class="card-actions mt-4">
              <a href="#" class="text-secondary font-semibold text-sm flex items-center gap-1 hover:gap-2 transition-all duration-300">
                Read Full Article
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          </div>
        </article>

        <article class="scroll-reveal opacity-0 card bg-base-200 border border-base-300 shadow-lg hover:border-secondary/30 transition-all duration-300 group" style="animation-delay: 0.1s;">
          <!-- Article image placeholder -->
          <figure class="bg-gradient-to-br from-secondary/10 via-base-300/50 to-primary/10 flex items-center justify-center h-48 relative">
            <div class="text-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-secondary/20 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              <p class="text-[10px] text-base-content/20 mt-1">Article image</p>
            </div>
          </figure>
          <div class="h-1 bg-gradient-to-r from-secondary to-accent"></div>
          <div class="card-body">
            <div class="flex items-center gap-3 text-sm text-base-content/50 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              28 January 2026
              <span class="badge badge-secondary badge-xs">Club News</span>
            </div>
            <h2 class="card-title font-heading text-2xl group-hover:text-secondary transition-colors">
              New Coaching Staff Announced
            </h2>
            <p class="text-base-content/70 leading-relaxed">
              We are excited to welcome new coaches to the Norstar family for the 2026 season.
              Our growing team of experienced coaches will bring fresh ideas and energy to all our programmes.
            </p>
            <div class="card-actions mt-4">
              <a href="#" class="text-secondary font-semibold text-sm flex items-center gap-1 hover:gap-2 transition-all duration-300">
                Read Full Article
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          </div>
        </article>

        <article class="scroll-reveal opacity-0 card bg-base-200 border border-base-300 shadow-lg hover:border-secondary/30 transition-all duration-300 group" style="animation-delay: 0.2s;">
          <!-- Article image placeholder -->
          <figure class="bg-gradient-to-br from-info/10 via-base-300/50 to-secondary/10 flex items-center justify-center h-48 relative">
            <div class="text-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-info/20 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              <p class="text-[10px] text-base-content/20 mt-1">Article image</p>
            </div>
          </figure>
          <div class="h-1 bg-gradient-to-r from-accent to-secondary"></div>
          <div class="card-body">
            <div class="flex items-center gap-3 text-sm text-base-content/50 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              15 January 2026
              <span class="badge badge-info badge-xs">Training</span>
            </div>
            <h2 class="card-title font-heading text-2xl group-hover:text-secondary transition-colors">
              Spring Training Schedule Released
            </h2>
            <p class="text-base-content/70 leading-relaxed">
              Our updated spring training schedule is now available. Sessions will continue on Saturdays and Wednesdays
              with additional Friday evening sessions for the U13 squad beginning in March.
            </p>
            <div class="card-actions mt-4">
              <a href="#" class="text-secondary font-semibold text-sm flex items-center gap-1 hover:gap-2 transition-all duration-300">
                Read Full Article
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Pagination -->
        <div class="scroll-reveal opacity-0 flex justify-center pt-8">
          <div class="join">
            <button class="join-item btn btn-sm btn-disabled">«</button>
            <button class="join-item btn btn-sm btn-secondary">1</button>
            <button class="join-item btn btn-sm">2</button>
            <button class="join-item btn btn-sm">3</button>
            <button class="join-item btn btn-sm">»</button>
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-8">

        <!-- Categories -->
        <div class="scroll-reveal opacity-0 card bg-base-200 border border-base-300 shadow-md">
          <div class="card-body">
            <h3 class="font-heading text-lg font-bold mb-3">Categories</h3>
            <ul class="space-y-2">
              <li><a href="#" class="flex items-center justify-between text-sm text-base-content/70 hover:text-secondary transition-colors">
                <span>All News</span>
                <span class="badge badge-ghost badge-xs">6</span>
              </a></li>
              <li><a href="#" class="flex items-center justify-between text-sm text-base-content/70 hover:text-secondary transition-colors">
                <span>Results</span>
                <span class="badge badge-ghost badge-xs">2</span>
              </a></li>
              <li><a href="#" class="flex items-center justify-between text-sm text-base-content/70 hover:text-secondary transition-colors">
                <span>Club News</span>
                <span class="badge badge-ghost badge-xs">2</span>
              </a></li>
              <li><a href="#" class="flex items-center justify-between text-sm text-base-content/70 hover:text-secondary transition-colors">
                <span>Registration</span>
                <span class="badge badge-ghost badge-xs">1</span>
              </a></li>
              <li><a href="#" class="flex items-center justify-between text-sm text-base-content/70 hover:text-secondary transition-colors">
                <span>Training</span>
                <span class="badge badge-ghost badge-xs">1</span>
              </a></li>
            </ul>
          </div>
        </div>

        <!-- Upcoming fixtures mini -->
        <div class="scroll-reveal opacity-0 card bg-base-200 border border-base-300 shadow-md" style="animation-delay: 0.1s;">
          <div class="card-body">
            <h3 class="font-heading text-lg font-bold mb-3">Next Fixture</h3>
            <div class="bg-base-300/50 rounded-xl p-4 text-center">
              <p class="text-xs text-base-content/50 uppercase tracking-wider mb-1">Sat 15 Feb &bull; 14:00</p>
              <p class="font-heading font-bold text-lg">Norstar U13</p>
              <p class="text-xs text-accent font-bold my-1">VS</p>
              <p class="font-heading font-bold text-lg">Belfast Blades</p>
              <p class="text-xs text-base-content/50 mt-2">Seven Towers, Ballymena</p>
            </div>
            <a href="/fixtures" class="btn btn-outline btn-secondary btn-sm mt-3 w-full">View All Fixtures</a>
          </div>
        </div>

        <!-- Newsletter signup placeholder -->
        <div class="scroll-reveal opacity-0 card bg-gradient-to-b from-secondary/10 to-base-200 border border-secondary/20 shadow-md" style="animation-delay: 0.2s;">
          <div class="card-body text-center">
            <h3 class="font-heading text-lg font-bold mb-2">Stay Updated</h3>
            <p class="text-sm text-base-content/60 mb-4">Get news and fixtures delivered to your inbox.</p>
            <div class="form-control">
              <div class="join w-full">
                <input type="email" placeholder="you@email.com" class="input input-bordered input-sm join-item w-full focus:input-secondary" />
                <button class="btn btn-secondary btn-sm join-item">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                </button>
              </div>
            </div>
            <p class="text-[10px] text-base-content/30 mt-2">Newsletter coming soon — powered by backend API.</p>
          </div>
        </div>

      </aside>

    </div>
  </div>
</section>

{% endblock %}
