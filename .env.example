# Backend API base URL
API_URL=http://localhost:3000

# Session secret — REQUIRED in production. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password reset redirect (where the email link sends users)
# Must match an allowed redirect URL in Supabase Auth settings
PASSWORD_RESET_REDIRECT_URL=http://localhost:4000/reset-password

# Server
PORT=4000
NODE_ENV=development
