<!-- ======== NAVBAR ======== -->
<div class="navbar bg-base-100/95 backdrop-blur-sm sticky top-0 z-50 border-b border-base-300 px-4 lg:px-8 min-h-[64px]">
  
  <!-- Mobile menu button -->
  <div class="navbar-start">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost lg:hidden" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
        </svg>
      </div>
      <!-- Mobile dropdown -->
      <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow-xl bg-base-200 rounded-box w-56 border border-base-300 animate-slide-down">
        <li><a href="/" class="font-medium">Home</a></li>
        {% if isLoggedIn %}<li><a href="/fixtures" class="font-medium">Fixtures</a></li>{% endif %}
        <li><a href="/news" class="font-medium">News</a></li>
        <li><a href="/learn-to-skate" class="font-medium">Learn to Skate</a></li>
        <li><a href="/contact" class="font-medium">Contact</a></li>
        <li>
          <a href="/shop" class="font-medium">
            Shop
          </a>
        </li>
        <li><a href="/sponsors" class="font-medium text-accent">Sponsors</a></li>
        <li class="mt-2 border-t border-base-300 pt-2">
          {% if isLoggedIn %}
            <a href="/dashboard" class="font-medium">Dashboard</a>
          {% else %}
            <a href="/login" class="font-medium text-secondary" data-open-login>Login</a>
          {% endif %}
        </li>
      </ul>
    </div>

    <!-- Logo / Brand -->
    <a href="/" class="btn btn-ghost gap-2 px-2 hover:bg-base-200">
      <img src="/images/Norstar.png" alt="Norstar" class="h-9 w-9 object-contain rounded-full" />
      <span class="font-heading font-bold text-lg tracking-tight hidden sm:inline"><span class="text-secondary">NOR</span>STAR</span>
    </a>
  </div>

  <!-- Desktop nav links -->
  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal px-1 gap-1">
      <li>
        <a href="/" class="font-medium text-base hover:text-secondary transition-colors duration-200 rounded-lg">
          Home
        </a>
      </li>
      {% if isLoggedIn %}
      <li>
        <a href="/fixtures" class="font-medium text-base hover:text-secondary transition-colors duration-200 rounded-lg">
          Fixtures
        </a>
      </li>
      {% endif %}
      <li>
        <a href="/news" class="font-medium text-base hover:text-secondary transition-colors duration-200 rounded-lg">
          News
        </a>
      </li>
      <li>
        <a href="/learn-to-skate" class="font-medium text-base hover:text-secondary transition-colors duration-200 rounded-lg">
          Learn to Skate
        </a>
      </li>
      <li>
        <a href="/contact" class="font-medium text-base hover:text-secondary transition-colors duration-200 rounded-lg">
          Contact
        </a>
      </li>
      <li>
        <a href="/shop" class="font-medium text-base hover:text-secondary transition-colors duration-200 rounded-lg">
          Shop
        </a>
      </li>
    </ul>
  </div>

  <!-- Auth button -->
  <div class="navbar-end gap-2">

    <!-- Sponsor placeholder slot -->
    <a href="/sponsors"
       class="hidden md:flex items-center gap-2 mr-1 px-3 py-1.5 rounded-lg border border-dashed border-base-300 hover:border-accent/60 hover:bg-base-200 transition-colors group"
       aria-label="Sponsorship opportunities">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/30 group-hover:text-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span class="leading-tight text-left">
        <span class="block text-[10px] uppercase tracking-wider text-base-content/40 group-hover:text-accent transition-colors">Sponsor</span>
        <span class="block text-xs font-semibold text-base-content/60 group-hover:text-accent transition-colors">Your logo here</span>
      </span>
    </a>

    {% if isLoggedIn %}
      {% if isImpersonating %}
        <div class="badge badge-accent badge-sm gap-1 mr-1 hidden sm:flex">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          {{ viewAsRole | capitalize }}
        </div>
      {% endif %}
      <a href="/dashboard" class="btn btn-ghost btn-sm lg:btn-md font-semibold gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
        </svg>
        <span class="hidden sm:inline">Dashboard</span>
      </a>
      <a href="/logout" class="btn btn-secondary btn-sm lg:btn-md font-semibold gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span class="hidden sm:inline">Logout</span>
      </a>
    {% else %}
      <a href="/login" id="login-btn" class="btn btn-secondary btn-sm lg:btn-md font-semibold gap-2" data-open-login>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="hidden sm:inline">Login</span>
      </a>
    {% endif %}
  </div>
</div>
