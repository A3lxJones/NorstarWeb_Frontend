{% extends "layouts/base.njk" %}

{% block content %}
{% include "partials/impersonation-banner.njk" %}

<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-2xl">

    <!-- Back link -->
    <a href="/dashboard/children/{{ child.id }}" class="btn btn-ghost btn-sm gap-1 mb-6 -ml-2 text-base-content/60 hover:text-secondary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Profile
    </a>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="font-heading text-3xl font-bold">
        Edit {{ child.first_name }}<span class="text-secondary">.</span>
      </h1>
      <p class="text-base-content/60 mt-1">Update your child's details</p>
    </div>

    {% if error %}
    <div class="alert alert-error text-sm mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{{ error }}</span>
    </div>
    {% endif %}

    <!-- Edit Child Form -->
    <div class="card bg-base-200 border border-base-300 shadow-xl">
      <div class="card-body">
        <form action="/dashboard/children/{{ child.id }}/edit" method="POST" class="space-y-6" novalidate>

          <!-- Honeypot -->
          <div class="hidden" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <!-- ─── Personal Details ─── -->
          <div>
            <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Personal Details
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label" for="edit-first-name">
                  <span class="label-text font-medium">First Name <span class="text-error">*</span></span>
                </label>
                <input type="text" id="edit-first-name" name="first_name"
                       value="{{ child.first_name or '' }}"
                       class="input input-bordered w-full focus:input-secondary transition-colors"
                       required autocomplete="given-name" maxlength="100" />
              </div>
              <div class="form-control">
                <label class="label" for="edit-last-name">
                  <span class="label-text font-medium">Last Name <span class="text-error">*</span></span>
                </label>
                <input type="text" id="edit-last-name" name="last_name"
                       value="{{ child.last_name or '' }}"
                       class="input input-bordered w-full focus:input-secondary transition-colors"
                       required autocomplete="family-name" maxlength="100" />
              </div>

              <!-- Gender -->
              <div class="form-control">
                <label class="label" for="edit-gender">
                  <span class="label-text font-medium">Gender</span>
                </label>
                <select id="edit-gender" name="gender"
                        class="select select-bordered w-full focus:select-secondary transition-colors">
                  <option value="" {% if not child.gender %}selected{% endif %}>Select gender</option>
                  <option value="male" {% if child.gender == 'male' %}selected{% endif %}>Male</option>
                  <option value="female" {% if child.gender == 'female' %}selected{% endif %}>Female</option>
                  <option value="other" {% if child.gender == 'other' %}selected{% endif %}>Other</option>
                  <option value="prefer_not_to_say" {% if child.gender == 'prefer_not_to_say' %}selected{% endif %}>Prefer not to say</option>
                </select>
              </div>
            </div>

            <div class="form-control mt-4">
              <label class="label" for="edit-dob">
                <span class="label-text font-medium">Date of Birth <span class="text-error">*</span></span>
              </label>
              <input type="date" id="edit-dob" name="date_of_birth"
                     value="{{ child.date_of_birth or '' }}"
                     class="input input-bordered w-full focus:input-secondary transition-colors"
                     required autocomplete="bday" />
            </div>
          </div>

          <div class="divider"></div>

          <!-- ─── Hockey Details ─── -->
          <div>
            <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Hockey Details
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label" for="edit-skill">
                  <span class="label-text font-medium">Skill Level</span>
                </label>
                <select id="edit-skill" name="skill_level"
                        class="select select-bordered w-full focus:select-secondary transition-colors">
                  <option value="" {% if not child.skill_level %}selected{% endif %}>Select level</option>
                  <option value="beginner" {% if child.skill_level == 'beginner' %}selected{% endif %}>Beginner</option>
                  <option value="intermediate" {% if child.skill_level == 'intermediate' %}selected{% endif %}>Intermediate</option>
                  <option value="advanced" {% if child.skill_level == 'advanced' %}selected{% endif %}>Advanced</option>
                </select>
              </div>
              <div class="form-control">
                <label class="label" for="edit-position">
                  <span class="label-text font-medium">Preferred Position</span>
                </label>
                <select id="edit-position" name="position"
                        class="select select-bordered w-full focus:select-secondary transition-colors">
                  <option value="" {% if not child.position %}selected{% endif %}>Select position</option>
                  <option value="forward" {% if child.position == 'forward' %}selected{% endif %}>Forward</option>
                  <option value="defense" {% if child.position == 'defense' %}selected{% endif %}>Defence</option>
                  <option value="goalie" {% if child.position == 'goalie' %}selected{% endif %}>Goalie</option>
                </select>
              </div>
            </div>
          </div>

          <div class="divider"></div>

          <!-- ─── Emergency Contact ─── -->
          <div>
            <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Emergency Contact
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label" for="edit-ec-name">
                  <span class="label-text font-medium">Contact Name <span class="text-error">*</span></span>
                </label>
                <input type="text" id="edit-ec-name" name="emergency_contact_name"
                       value="{{ child.emergency_contact_name or '' }}"
                       class="input input-bordered w-full focus:input-secondary transition-colors"
                       required maxlength="100" />
              </div>
              <div class="form-control">
                <label class="label" for="edit-ec-phone">
                  <span class="label-text font-medium">Contact Phone <span class="text-error">*</span></span>
                </label>
                <input type="tel" id="edit-ec-phone" name="emergency_contact_phone"
                       value="{{ child.emergency_contact_phone or '' }}"
                       class="input input-bordered w-full focus:input-secondary transition-colors"
                       required autocomplete="tel" maxlength="20" />
              </div>
            </div>
          </div>

          <div class="divider"></div>

          <!-- ─── Medical Information ─── -->
          <div>
            <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Medical Information
            </h2>

            <div class="form-control">
              <label class="label" for="edit-medical">
                <span class="label-text font-medium">Medical Conditions</span>
              </label>
              <textarea id="edit-medical" name="medical_conditions" rows="3"
                        class="textarea textarea-bordered w-full focus:textarea-secondary transition-colors"
                        maxlength="2000">{{ child.medical_conditions or '' }}</textarea>
            </div>

            <div class="form-control mt-4">
              <label class="label" for="edit-allergies">
                <span class="label-text font-medium">Allergies</span>
              </label>
              <textarea id="edit-allergies" name="allergies" rows="2"
                        class="textarea textarea-bordered w-full focus:textarea-secondary transition-colors"
                        maxlength="2000">{{ child.allergies or '' }}</textarea>
            </div>
          </div>

          <div class="divider"></div>

          <!-- ─── Consent ─── -->
          <div>
            <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              Consent
            </h2>

            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="photo_consent"
                     class="checkbox checkbox-secondary mt-1"
                     {% if child.photo_consent %}checked{% endif %} />
              <span class="label-text">
                I give permission for photos/videos of my child to be taken and used on the Norstar website and social media channels.
              </span>
            </label>
          </div>

          <!-- Submit -->
          <div class="flex flex-col sm:flex-row gap-3 pt-4">
            <button type="submit" class="btn btn-secondary font-semibold gap-2 hover:scale-[1.02] transition-all flex-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Save Changes
            </button>
            <a href="/dashboard/children/{{ child.id }}" class="btn btn-ghost font-semibold">Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </div>
</section>
{% endblock %}
