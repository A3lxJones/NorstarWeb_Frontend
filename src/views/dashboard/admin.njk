{% extends "layouts/base.njk" %}

{% block content %}
<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-6xl">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="font-heading text-3xl font-bold">
          Admin Dashboard<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/60 mt-1">Full overview of Norstar operations</p>
      </div>

      <!-- Role Switcher: View As -->
      <div class="flex items-center gap-2">
        <a href="/dashboard/users" class="btn btn-xs btn-secondary gap-1 hover:scale-[1.02] transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Members
        </a>
        <a href="/dashboard/children/all" class="btn btn-xs btn-secondary gap-1 hover:scale-[1.02] transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m3-2.803a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          Children
        </a>
        <span class="text-xs text-base-content/50 uppercase tracking-wide font-semibold hidden sm:inline">View as:</span>
        <div class="flex gap-1">
          <form action="/dashboard/switch-role" method="POST" class="inline">
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" />
            <input type="hidden" name="role" value="parent" />
            <button type="submit" class="btn btn-xs btn-outline btn-secondary gap-1 hover:scale-[1.02] transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Parent
            </button>
          </form>
          <form action="/dashboard/switch-role" method="POST" class="inline">
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" />
            <input type="hidden" name="role" value="coach" />
            <button type="submit" class="btn btn-xs btn-outline btn-accent gap-1 hover:scale-[1.02] transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              Coach
            </button>
          </form>
        </div>
      </div>
    </div>

    {% if error %}
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{{ error }}</span>
    </div>
    {% endif %}

    <!-- Stats overview -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="stat bg-base-200 border border-base-300 rounded-box p-4">
        <div class="stat-title text-xs">Parents</div>
        <div class="stat-value text-2xl text-secondary">{{ userCounts.parent or 0 }}</div>
      </div>
      <div class="stat bg-base-200 border border-base-300 rounded-box p-4">
        <div class="stat-title text-xs">Coaches</div>
        <div class="stat-value text-2xl text-secondary">{{ userCounts.coach or 0 }}</div>
      </div>
      <div class="stat bg-base-200 border border-base-300 rounded-box p-4">
        <div class="stat-title text-xs">Teams</div>
        <div class="stat-value text-2xl text-secondary">{{ teamCount or teams | length }}</div>
      </div>
      <div class="stat bg-base-200 border border-base-300 rounded-box p-4">
        <div class="stat-title text-xs">Upcoming Games</div>
        <div class="stat-value text-2xl text-secondary">{{ games | length }}</div>
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">

      <!-- Teams section -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-heading text-xl font-semibold">Teams</h2>
          <a href="/dashboard/teams/create" class="btn btn-secondary btn-xs gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New
          </a>
        </div>

        {% if teams.length === 0 %}
        <div class="card bg-base-200 border border-base-300">
          <div class="card-body text-center py-8">
            <p class="text-base-content/60 text-sm">No teams created yet.</p>
          </div>
        </div>
        {% else %}
        <div class="space-y-2">
          {% for team in teams %}
          <a href="/dashboard/teams/{{ team.id }}" class="card bg-base-200 border border-base-300 shadow hover:shadow-md transition-shadow block">
            <div class="card-body p-3">
              <h3 class="font-semibold text-sm">{{ team.name }}</h3>
              <p class="text-xs text-base-content/60">{{ team.age_group }}</p>
            </div>
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <!-- Games section -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-heading text-xl font-semibold">Recent Games</h2>
          <a href="/dashboard/games/create" class="btn btn-secondary btn-xs gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New
          </a>
        </div>

        {% if games.length === 0 %}
        <div class="card bg-base-200 border border-base-300">
          <div class="card-body text-center py-8">
            <p class="text-base-content/60 text-sm">No games scheduled yet.</p>
          </div>
        </div>
        {% else %}
        <div class="space-y-2">
          {% for game in games %}
          <a href="/dashboard/games/{{ game.id }}" class="card bg-base-200 border border-base-300 shadow hover:shadow-md transition-shadow block">
            <div class="card-body p-3">
              <div class="flex items-center gap-2">
                <span class="badge badge-xs {% if game.type === 'match' %}badge-primary{% else %}badge-accent{% endif %}">
                  {{ game.type }}
                </span>
                <h3 class="font-semibold text-sm">
                  {% if game.opponent %}vs {{ game.opponent }}{% else %}{{ game.type | title }}{% endif %}
                </h3>
              </div>
              <p class="text-xs text-base-content/60">{{ game.date }}</p>
            </div>
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <!-- Reports section -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-heading text-xl font-semibold">Reports</h2>
          <a href="/dashboard/reports/create" class="btn btn-secondary btn-xs gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New
          </a>
        </div>

        {% if reports.length === 0 %}
        <div class="card bg-base-200 border border-base-300">
          <div class="card-body text-center py-8">
            <p class="text-base-content/60 text-sm">No reports filed yet.</p>
          </div>
        </div>
        {% else %}
        <div class="space-y-2">
          {% for report in reports %}
          <a href="/dashboard/reports/{{ report.id }}" class="card bg-base-200 border border-base-300 shadow hover:shadow-md transition-shadow block">
            <div class="card-body p-3">
              <h3 class="font-semibold text-sm">{{ report.title }}</h3>
              <p class="text-xs text-base-content/60">{{ report.type }} · {{ report.created_at | truncate(10, true, '') }}</p>
            </div>
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>

    </div>

  </div>
</section>
{% endblock %}
