{% extends "layouts/base.njk" %}

{% block content %}

<!-- Page Header -->
<section class="bg-base-200/60 border-b border-base-300">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl py-14 lg:py-20">
    <div class="max-w-3xl">
      <span class="eyebrow mb-3 block">Club Updates</span>
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4">Latest news</h1>
      <p class="text-base-content/65 text-lg max-w-xl">
        All the latest from Norstar Inline Hockey Club.
      </p>
    </div>
  </div>
</section>

<!-- Featured Article -->
<section class="py-16 lg:py-20">
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">

    <div class="scroll-reveal opacity-0 card bg-base-100 border border-base-300 overflow-hidden group lg:card-side">
      <!-- Image -->
      <figure class="lg:w-2/5 bg-base-200 flex items-center justify-center min-h-[240px] relative overflow-hidden">
        <img src="/images/acc2b74e-0675-4bfb-b2c6-2c642ae2e2f2.png" alt="Featured news image" class="w-full h-full object-cover" />
        <div class="absolute top-4 left-4">
          <span class="badge badge-secondary font-medium">Featured</span>
        </div>
      </figure>
      <div class="card-body lg:w-3/5 p-8">
        <div class="flex items-center gap-3 text-sm text-base-content/50 mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
           August 2026
          <span class="badge badge-secondary badge-xs">Registration</span>
        </div>
        <h2 class="card-title font-heading text-2xl md:text-3xl group-hover:text-secondary transition-colors">
          Season Registration Now Open
        </h2>
        <p class="text-base-content/70 leading-relaxed mt-2">
          Registration for the upcoming spring season is now open! Whether you're returning or joining for the first time,
          head to our registration page to secure your spot.
          We have places across our programmes — Junior U12/U14. News soon on Learn to Skate.
        </p>
      </div>
    </div>

  </div>
</section>

<!-- News Grid + Sidebar -->
<section class="py-8 lg:py-12">
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
    <div class="space-y-8">

        <article class="scroll-reveal opacity-0 card bg-base-100 border border-base-300 overflow-hidden group hover:border-secondary/40 transition-colors">

          <div class="card-body">
            <div class="flex items-center gap-3 text-sm text-base-content/50 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              10 May 2026
              <span class="badge badge-accent badge-xs">Results</span>
            </div>
            <h2 class="card-title font-heading text-2xl group-hover:text-secondary transition-colors">
              U13s Win League!
            </h2>
            <p class="text-base-content/70 leading-relaxed">
              After the most tightly contested U14 Season yet, Norstar comes out on Top! After a thrilling unbeaten season. Norstar come 
              out to play their final game against the Flying Ducks, an all to play for game. We needed a draw or a win to become
              uncontested for the league title. After a close game Norstar draw with a 2-2 game. All eyes are now on the Playoffs!
            </p>
          </div>
        </article>

        <article class="scroll-reveal opacity-0 card bg-base-100 border border-base-300 overflow-hidden group hover:border-secondary/40 transition-colors" style="animation-delay: 0.1s;">
          <div class="card-body">
            <div class="flex items-center gap-3 text-sm text-base-content/50 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
             
              <span class="badge badge-secondary badge-xs">Club News</span>
            </div>
            <h2 class="card-title font-heading text-2xl group-hover:text-secondary transition-colors">
              Coaches International!
            </h2>
            <p class="text-base-content/70 leading-relaxed">
              Big congratulations to our coaches who have both been selected for Ireland International teams, Joe has been 
              selected to play for the Masters Ireland team (38+) and Alex has been selected to play in the PAMA Flag Cup 
              for the Ireland Senior mens National Team! Best of luck to both of our coaches!
            </p>
          </div>
        </article>

        <article class="scroll-reveal opacity-0 card bg-base-100 border border-base-300 overflow-hidden group hover:border-secondary/40 transition-colors" style="animation-delay: 0.2s;">
          <div class="card-body">
            <div class="flex items-center gap-3 text-sm text-base-content/50 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              15 January 2026
              <span class="badge badge-info badge-xs">Playoffs</span>
            </div>
            <h2 class="card-title font-heading text-2xl group-hover:text-secondary transition-colors">
              U13 Academy Team Win the Playoffs!
            </h2>
            <p class="text-base-content/70 leading-relaxed">
              Congratulations to our U13 Academy team on winning the playoffs in Waterford over the 19th-21st of June!
              This is the first year that the club has accomplished this, and we are delighted to bring home more silverware!
            </p>
          </div>
        </article>

    </div>
  </div>
</section>

{% endblock %}
