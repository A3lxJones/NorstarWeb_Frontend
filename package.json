{
    "name": "norstar-web-frontend",
    "version": "1.0.0",
    "description": "Norstar Inline Hockey Club - Ballymena - Frontend",
    "main": "dist/server.js",
    "scripts": {
        "build:ts": "tsc",
        "build:css": "npx tailwindcss -i ./src/public/css/input.css -o ./src/public/css/output.css --minify",
        "build": "npm run build:css && npm run build:ts",
        "dev:ts": "tsc --watch",
        "dev:css": "npx tailwindcss -i ./src/public/css/input.css -o ./src/public/css/output.css --watch",
        "dev:server": "nodemon dist/server.js",
        "dev": "concurrently \"npm run dev:css\" \"npm run dev:ts\" \"npm run dev:server\"",
        "start": "node dist/server.js"
    },
    "keywords": [
        "inline-hockey",
        "ballymena",
        "norstar"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "express": "^4.21.0",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "nunjucks": "^3.2.4"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/express-rate-limit": "^5.1.3",
        "@types/node": "^20.11.0",
        "@types/nunjucks": "^3.2.6",
        "concurrently": "^8.2.2",
        "daisyui": "^4.12.0",
        "nodemon": "^3.0.3",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3"
    }
}
