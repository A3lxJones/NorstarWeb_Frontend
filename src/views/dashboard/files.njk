{% extends "layouts/base.njk" %}

{% block content %}
{% include "partials/impersonation-banner.njk" %}

<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-4xl">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="font-heading text-3xl font-bold">
          Important Files<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/60 mt-1">Club documents, policies and procedures</p>
      </div>
      <a href="/dashboard" class="btn btn-ghost btn-sm gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Dashboard
      </a>
    </div>

    <div class="grid gap-4 md:grid-cols-2">

      <!-- Welcome Letter -->
      <a href="/documents/WelcomeLetter.pdf" target="_blank" rel="noopener noreferrer"
         class="card bg-gradient-to-br from-accent/10 via-base-200 to-accent/5 border border-accent/20 shadow-lg hover:shadow-xl hover:border-accent/40 transition-all duration-300 hover:scale-[1.02] group scroll-reveal opacity-0">
        <div class="card-body p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-accent/20 flex items-center justify-center shrink-0 group-hover:bg-accent/30 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-heading font-semibold text-lg group-hover:text-accent transition-colors">
                Welcome Letter
              </h3>
              <p class="text-sm text-base-content/60 mt-1">
                Our welcome pack with club information and expectations
              </p>
            </div>
          </div>
        </div>
      </a>

      <!-- Player Code of Conduct -->
      <a href="/documents/PlayerCodeOfConduct.pdf" target="_blank" rel="noopener noreferrer"
         class="card bg-gradient-to-br from-secondary/10 via-base-200 to-secondary/5 border border-secondary/20 shadow-lg hover:shadow-xl hover:border-secondary/40 transition-all duration-300 hover:scale-[1.02] group scroll-reveal opacity-0">
        <div class="card-body p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-secondary/20 flex items-center justify-center shrink-0 group-hover:bg-secondary/30 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-heading font-semibold text-lg group-hover:text-secondary transition-colors">
                Player Code of Conduct
              </h3>
              <p class="text-sm text-base-content/60 mt-1">
                The standards we expect from every player
              </p>
            </div>
          </div>
        </div>
      </a>

      <!-- Discipline Procedures -->
      <a href="/documents/DisciplinaryProcedure.pdf" target="_blank" rel="noopener noreferrer"
         class="card bg-gradient-to-br from-warning/10 via-base-200 to-warning/5 border border-warning/20 shadow-lg hover:shadow-xl hover:border-warning/40 transition-all duration-300 hover:scale-[1.02] group scroll-reveal opacity-0">
        <div class="card-body p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-warning/20 flex items-center justify-center shrink-0 group-hover:bg-warning/30 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-heading font-semibold text-lg group-hover:text-warning transition-colors">
                Discipline Procedures
              </h3>
              <p class="text-sm text-base-content/60 mt-1">
                Our disciplinary procedure and process
              </p>
            </div>
          </div>
        </div>
      </a>

      <!-- Data Protection -->
      <a href="/documents/DataProtectionPolicy.pdf" target="_blank" rel="noopener noreferrer"
         class="card bg-gradient-to-br from-info/10 via-base-200 to-info/5 border border-info/20 shadow-lg hover:shadow-xl hover:border-info/40 transition-all duration-300 hover:scale-[1.02] group scroll-reveal opacity-0">
        <div class="card-body p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-info/20 flex items-center justify-center shrink-0 group-hover:bg-info/30 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-heading font-semibold text-lg group-hover:text-info transition-colors">
                Data Protection
              </h3>
              <p class="text-sm text-base-content/60 mt-1">
                How we collect, use and protect your data
              </p>
            </div>
          </div>
        </div>
      </a>

      <!-- Club Organisation -->
      <a href="/documents/ClubOrganisationChart.pptx" target="_blank" rel="noopener noreferrer"
         class="card bg-gradient-to-br from-success/10 via-base-200 to-success/5 border border-success/20 shadow-lg hover:shadow-xl hover:border-success/40 transition-all duration-300 hover:scale-[1.02] group scroll-reveal opacity-0">
        <div class="card-body p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-success/20 flex items-center justify-center shrink-0 group-hover:bg-success/30 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 8v-4a1 1 0 011-1h2a1 1 0 011 1v4" />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-heading font-semibold text-lg group-hover:text-success transition-colors">
                Club Organisation
              </h3>
              <p class="text-sm text-base-content/60 mt-1">
                Our club structure and organisation chart
              </p>
            </div>
          </div>
        </div>
      </a>

      {% if isCoach %}
      <!-- Coaches Code of Conduct — coaches only -->
      <a href="/documents/CoachesCodeOfConduct.pdf" target="_blank" rel="noopener noreferrer"
         class="card bg-gradient-to-br from-primary/10 via-base-200 to-primary/5 border border-primary/20 shadow-lg hover:shadow-xl hover:border-primary/40 transition-all duration-300 hover:scale-[1.02] group scroll-reveal opacity-0">
        <div class="card-body p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center shrink-0 group-hover:bg-primary/30 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <h3 class="font-heading font-semibold text-lg group-hover:text-primary transition-colors">
                  Coaches Code of Conduct
                </h3>
                <span class="badge badge-primary badge-xs">Coaches only</span>
              </div>
              <p class="text-sm text-base-content/60 mt-1">
                Standards and conduct expected of coaches
              </p>
            </div>
          </div>
        </div>
      </a>
      {% endif %}

    </div>
  </div>
</section>
{% endblock %}
