{% extends "layouts/base.njk" %}

{% block content %}
{% include "partials/impersonation-banner.njk" %}

<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-4xl">

    <!-- Back link -->
    <a href="/dashboard/availability" class="btn btn-ghost btn-sm gap-1 mb-6 -ml-2 text-base-content/60 hover:text-secondary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      All Requests
    </a>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="badge {% if request.request_type === 'match' %}badge-primary{% elif request.request_type === 'training' %}badge-accent{% else %}badge-ghost{% endif %}">
            {% if request.request_type === 'other' and request.custom_request_type %}
              {{ request.custom_request_type }}
            {% else %}
              {{ request.request_type | capitalize }}
            {% endif %}
          </span>
          {% if request.team_name %}
          <span class="text-sm text-base-content/40">{{ request.team_name }}</span>
          {% endif %}
        </div>
        <h1 class="font-heading text-3xl font-bold">
          {{ request.title }}<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/60 mt-1">
          📅 {{ request.event_date }}
          {% if request.deadline %}
            · ⏰ Responses by {{ request.deadline }}
          {% endif %}
        </p>
        {% if request.notes %}
        <p class="text-base-content/60 mt-2 text-sm italic">{{ request.notes }}</p>
        {% endif %}
      </div>

      <!-- Delete button -->
      <form action="/dashboard/availability/{{ request.id }}/delete" method="POST"
            data-confirm="Delete this availability request? This cannot be undone." class="shrink-0">
        <button type="submit" class="btn btn-ghost btn-sm text-error hover:bg-error/10" id="delete-btn">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Delete
        </button>
      </form>
    </div>

    <!-- Response Summary Cards -->
    {% if request.response_summary %}
    <div class="grid grid-cols-3 gap-4 mb-8">
      <div class="stat bg-success/10 border border-success/20 rounded-box p-4">
        <div class="stat-title text-xs text-success">Available</div>
        <div class="stat-value text-2xl text-success">{{ request.response_summary.available }}</div>
      </div>
      <div class="stat bg-error/10 border border-error/20 rounded-box p-4">
        <div class="stat-title text-xs text-error">Unavailable</div>
        <div class="stat-value text-2xl text-error">{{ request.response_summary.unavailable }}</div>
      </div>
      <div class="stat bg-base-200 border border-base-300 rounded-box p-4">
        <div class="stat-title text-xs">Pending</div>
        <div class="stat-value text-2xl text-base-content/40">{{ request.response_summary.pending }}</div>
      </div>
    </div>
    {% endif %}

    <!-- Responses Table -->
    <div class="card bg-base-200 border border-base-300 shadow-xl">
      <div class="card-body">
        <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          Responses
        </h2>

        {% if responses.length === 0 and pendingMembers.length === 0 %}
        <div class="text-center py-8">
          <p class="text-base-content/60">No responses yet. Parents will appear here once they reply.</p>
        </div>
        {% else %}
        <div class="overflow-x-auto">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>Player</th>
                <th>Parent</th>
                <th>Status</th>
                <th>Responded</th>
              </tr>
            </thead>
            <tbody>
              {% for response in responses %}
              <tr>
                <td class="font-medium">{{ response.child_name or 'Unknown' }}</td>
                <td class="text-base-content/60">{{ response.parent_name or '—' }}</td>
                <td>
                  {% if response.status === 'available' %}
                    <span class="badge badge-success badge-sm gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      Available
                    </span>
                  {% elif response.status === 'unavailable' %}
                    <span class="badge badge-error badge-sm gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                      Unavailable
                    </span>
                  {% endif %}
                </td>
                <td class="text-sm text-base-content/50">{{ response.responded_at }}</td>
              </tr>
              {% endfor %}

              {# Pending members who haven't responded yet #}
              {% for member in pendingMembers %}
              <tr class="opacity-60">
                <td class="font-medium">{{ member.child_name }}</td>
                <td class="text-base-content/60">{{ member.parent_name or '—' }}</td>
                <td>
                  <span class="badge badge-ghost badge-sm gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Awaiting Response
                  </span>
                </td>
                <td class="text-sm text-base-content/30">—</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
      </div>
    </div>

  </div>
</section>

<!-- Delete confirmation using addEventListener (CSP-safe) -->
<script nonce="{{ cspNonce }}">
  (function () {
    var deleteBtn = document.getElementById('delete-btn');
    if (deleteBtn) {
      deleteBtn.addEventListener('click', function () {
        if (confirm('Are you sure you want to delete this availability request? All responses will be lost.')) {
          deleteBtn.closest('form').submit();
        }
      });
    }
  })();
</script>
{% endblock %}
