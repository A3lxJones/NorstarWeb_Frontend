{% extends "layouts/base.njk" %}

{% block structuredData %}
<script type="application/ld+json" nonce="{{ cspNonce }}">
{
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  "name": "Norstar Inline Hockey Club — Ballymena North Centre",
  "description": "Training venue for Norstar Inline Hockey Club junior teams and Learn to Skate sessions.",
  "url": "{{ canonicalUrl }}",
  "email": "info.norstarhockey@gmail.com",
  "image": "{{ siteUrl }}/images/NortstarTeams2.png",
  "parentOrganization": { "@id": "{{ siteUrl }}/#organization" },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Ballymena North Centre",
    "addressLocality": "Ballymena",
    "addressRegion": "County Antrim",
    "addressCountry": "GB"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "13:30",
      "closes": "16:30"
    }
  ]
}
</script>
{% endblock %}

{% block content %}

<!-- Page header -->
<section class="bg-base-200/60 border-b border-base-300">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl py-14 lg:py-20">
    <div class="max-w-3xl">
      <span class="eyebrow mb-3 block">Get in touch</span>
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4">Contact us</h1>
      <p class="text-base-content/65 text-lg max-w-xl">
        Have a question, want to register, or just want to say hello? We'd love to hear from you.
      </p>
    </div>
  </div>
</section>


<!-- Contact -->
<section class="py-16 lg:py-20 bg-base-100">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-12">

      <!-- Main column -->
      <div class="lg:col-span-3 scroll-reveal opacity-0">
        <div class="bg-base-100 border border-base-300 rounded-box overflow-hidden">
          <figure class="aspect-[16/9] bg-base-200">
            <img
              src="/images/playoffwinners.png"
              alt="Norstar Inline Hockey Club"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </figure>
          <div class="p-6 lg:p-8">
            <h2 class="font-heading text-2xl font-bold mb-3">How to reach us</h2>
            <p class="text-base-content/70 leading-relaxed mb-6">
              We don't currently use a website contact form. The best way to get in touch with the club is by email.
            </p>
            <div class="bg-base-200 border border-base-300 rounded-box p-5">
              <p class="text-xs uppercase tracking-[0.18em] text-base-content/50 mb-2">Club Email</p>
              <a href="mailto:info@norstarinline.com" class="font-heading text-xl font-bold text-secondary hover:text-accent transition-colors break-all">
                info.norstarhockey@gmail.com
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-2 scroll-reveal opacity-0 space-y-4" style="--animation-delay: 0.1s;">
        <h2 class="font-heading text-2xl font-bold mb-2">Club info</h2>

        <div class="bg-base-100 border border-base-300 rounded-box p-5 flex items-start gap-4">
          <div class="bg-secondary/10 text-secondary rounded-lg p-2.5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base mb-0.5">Location</h3>
            <p class="text-base-content/65 text-sm">
              <a href="https://www.google.com/maps?q=Ballymena+North+Centre,+Ballymena,+Co.+Antrim" target="_blank" rel="noopener noreferrer" class="hover:text-secondary transition-colors">Ballymena North Centre, Ballymena, Co. Antrim</a>
            </p>
          </div>
        </div>

        <div class="bg-base-100 border border-base-300 rounded-box p-5 flex items-start gap-4">
          <div class="bg-secondary/10 text-secondary rounded-lg p-2.5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base mb-0.5">Email</h3>
            <a href="mailto:info@norstarinline.com" class="text-secondary hover:text-accent transition-colors text-sm break-all">info.norstarhockey@gmail.com</a>
          </div>
        </div>

        <div class="bg-base-100 border border-base-300 rounded-box p-5 flex items-start gap-4">
          <div class="bg-secondary/10 text-secondary rounded-lg p-2.5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base mb-0.5">Training times</h3>
            <p class="text-base-content/65 text-sm">Saturdays 13:30–16:30</p>
            <p class="text-base-content/50 text-xs mt-1">13:30–14:45 U12/U14 &middot; 15:00–16:30 Academy</p>
          </div>
        </div>

        <!-- Social -->
        <div class="pt-2">
          <h3 class="font-heading font-bold text-base mb-3">Follow us</h3>
          <div class="flex gap-2">
            <a href="https://www.facebook.com/p/Ballymena-Norstar-Inline-Hockey-Club-100086120628419/" class="btn btn-sm btn-outline gap-2" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
              </svg>
              Facebook
            </a>
          </div>
        </div>
      </aside>

    </div>
  </div>
</section>


<!-- FAQ -->
<section class="py-16 lg:py-20 bg-base-200/60 border-t border-base-300">
  <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
    <div class="text-center mb-10">
      <span class="eyebrow mb-3 block">Questions?</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold">Frequently asked questions</h2>
    </div>

    <div class="space-y-3">
      <div class="scroll-reveal opacity-0 collapse collapse-arrow bg-base-100 border border-base-300">
        <input type="radio" name="faq" checked="checked" />
        <div class="collapse-title font-heading font-bold text-base">What age can my child start?</div>
        <div class="collapse-content">
          <p class="text-base-content/70">Our Learn to Skate programme is open to children aged 6 and up. Once they're comfortable on skates, they can progress to the competitive Junior U12/U14 squad.</p>
        </div>
      </div>

      <div class="scroll-reveal opacity-0 collapse collapse-arrow bg-base-100 border border-base-300">
        <input type="radio" name="faq" />
        <div class="collapse-title font-heading font-bold text-base">Do I need my own equipment?</div>
        <div class="collapse-content">
          <p class="text-base-content/70">For Learn to Skate sessions we provide all the equipment you need. For U12/U14, we recommend having your own inline skates and a hockey stick. Full protective gear is required for competitive play — we can advise on brands and sizing.</p>
        </div>
      </div>

      <div class="scroll-reveal opacity-0 collapse collapse-arrow bg-base-100 border border-base-300">
        <input type="radio" name="faq" />
        <div class="collapse-title font-heading font-bold text-base">What does it cost?</div>
        <div class="collapse-content">
          <p class="text-base-content/70">Pricing varies by programme. Contact us for the latest fees and sibling deals. We aim to keep costs accessible for all families.</p>
        </div>
      </div>

      <div class="scroll-reveal opacity-0 collapse collapse-arrow bg-base-100 border border-base-300">
        <input type="radio" name="faq" />
        <div class="collapse-title font-heading font-bold text-base">Where do you train?</div>
        <div class="collapse-content">
          <p class="text-base-content/70">All sessions take place at <a href="https://www.google.com/maps?q=Ballymena+North+Centre,+Ballymena,+Co.+Antrim" target="_blank" rel="noopener noreferrer" class="hover:text-secondary transition-colors">Ballymena North Centre</a> in Ballymena, Saturdays 13:30–16:30 (13:30–14:45 U12/U14 &middot; 15:00–16:30 Academy). Away matches are played at various venues across Northern Ireland and Ireland.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% endblock %}
