{% extends "layouts/base.njk" %}

{% block content %}
<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-4xl">

    <!-- Breadcrumb -->
    <div class="text-sm breadcrumbs mb-6">
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/dashboard/teams">Teams</a></li>
        <li class="text-base-content/60">{{ team.name }}</li>
      </ul>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="font-heading text-3xl font-bold">
          {{ team.name }}<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/60 mt-1">{{ team.age_group }}
          {% if team.max_players %} · Max {{ team.max_players }} players{% endif %}
        </p>
      </div>

      {% if success %}
      <div class="alert alert-success shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{{ success }}</span>
      </div>
      {% endif %}

      {% if canEdit %}
      <div class="flex gap-2">
        <a href="/dashboard/teams/{{ team.id }}/edit" class="btn btn-outline btn-sm gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit
        </a>
      </div>
      {% endif %}
      {% if isParent %}
      <div class="flex gap-2">
        <a href="/dashboard/teams/{{ team.id }}/register" class="btn btn-secondary btn-sm gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          Register Child
        </a>
      </div>
      {% endif %}
    </div>

    <div class="grid gap-8 lg:grid-cols-3">

      <!-- Team Info -->
      <div class="lg:col-span-1">
        <div class="card bg-base-200 border border-base-300 shadow">
          <div class="card-body p-5">
            <h2 class="font-heading font-semibold text-lg mb-3">Team Info</h2>

            <div class="space-y-3 text-sm">
              <div>
                <span class="text-base-content/50 text-xs uppercase tracking-wide">Age Group</span>
                <p class="font-medium">{{ team.age_group }}</p>
              </div>

              {% if team.coach %}
              <div>
                <span class="text-base-content/50 text-xs uppercase tracking-wide">Coach</span>
                <p class="font-medium">{{ team.coach.full_name }}</p>
                <p class="text-base-content/60 text-xs">{{ team.coach.email }}</p>
              </div>
              {% endif %}

              {% if team.max_players %}
              <div>
                <span class="text-base-content/50 text-xs uppercase tracking-wide">Roster Limit</span>
                <p class="font-medium">{{ team.members | length }} / {{ team.max_players }}</p>
              </div>
              {% else %}
              <div>
                <span class="text-base-content/50 text-xs uppercase tracking-wide">Players</span>
                <p class="font-medium">{{ team.members | length }}</p>
              </div>
              {% endif %}

              <div>
                <span class="text-base-content/50 text-xs uppercase tracking-wide">Created</span>
                <p class="font-medium">{{ team.created_at | truncate(10, true, '') }}</p>
              </div>
            </div>
          </div>
        </div>

        {% if canEdit %}
        <div class="mt-4">
          <form action="/dashboard/teams/{{ team.id }}/delete" method="POST"
                onsubmit="return confirm('Are you sure you want to delete this team? This cannot be undone.')">
            <button type="submit" class="btn btn-error btn-outline btn-sm btn-block gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              Delete Team
            </button>
          </form>
        </div>
        {% endif %}
      </div>

      <!-- Members -->
      <div class="lg:col-span-2">
        <div class="card bg-base-200 border border-base-300 shadow">
          <div class="card-body p-5">
            <h2 class="font-heading font-semibold text-lg mb-4">
              Approved Members
              <span class="badge badge-secondary badge-sm ml-2">{{ team.members | length }}</span>
            </h2>

            {% if team.members.length === 0 %}
            <div class="text-center py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/20 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <p class="text-base-content/60 text-sm">No approved members yet.<br>Parents can register their children for this team.</p>
            </div>
            {% else %}
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>DOB</th>
                    <th>Skill Level</th>
                    <th>Position</th>
                    {% if canEdit %}<th class="text-right">Actions</th>{% endif %}
                  </tr>
                </thead>
                <tbody>
                  {% for reg in team.members %}
                  <tr class="hover">
                    <td class="font-medium">{{ reg.child.first_name }} {{ reg.child.last_name }}</td>
                    <td class="text-base-content/60">{{ reg.child.date_of_birth }}</td>
                    <td>
                      {% if reg.child.skill_level %}
                        <span class="badge badge-outline badge-sm">{{ reg.child.skill_level }}</span>
                      {% else %}
                        <span class="text-base-content/40">—</span>
                      {% endif %}
                    </td>
                    <td>{{ reg.child.position or '—' }}</td>
                    {% if canEdit %}
                    <td class="text-right">
                      <button 
                        type="button"
                        class="btn btn-ghost btn-xs gap-1 edit-member-btn"
                        data-child-id="{{ reg.child.id }}"
                        data-child-name="{{ reg.child.first_name }} {{ reg.child.last_name }}"
                        data-skill-level="{{ reg.child.skill_level or '' }}"
                        data-position="{{ reg.child.position or '' }}"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        Edit
                      </button>
                    </td>
                    {% endif %}
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% endif %}
          </div>
        </div>

        <!-- Pending Registrations (Coach/Admin only) -->
        {% if canEdit %}
        <div class="card bg-base-200 border border-base-300 shadow mt-6">
          <div class="card-body p-5">
            <h2 class="font-heading font-semibold text-lg mb-4">
              Pending Requests
              <span class="badge badge-warning badge-sm ml-2">{{ pendingRegistrations | length }}</span>
            </h2>

            {% if pendingRegistrations.length === 0 %}
            <div class="text-center py-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-base-content/20 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-base-content/60 text-sm">No pending registration requests.</p>
            </div>
            {% else %}
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Child</th>
                    <th>Parent</th>
                    <th>Requested</th>
                    <th class="text-right">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for reg in pendingRegistrations %}
                  <tr class="hover">
                    <td class="font-medium">
                      {% if reg.child %}
                        {{ reg.child.first_name }} {{ reg.child.last_name }}
                      {% else %}
                        <span class="text-base-content/40">Unknown</span>
                      {% endif %}
                    </td>
                    <td class="text-base-content/60">
                      {% if reg.parent %}
                        {{ reg.parent.full_name or reg.parent.email }}
                      {% else %}
                        <span class="text-base-content/40">—</span>
                      {% endif %}
                    </td>
                    <td class="text-base-content/60">
                      {{ reg.created_at | truncate(10, true, '') if reg.created_at else '—' }}
                    </td>
                    <td class="text-right">
                      <div class="flex gap-1 justify-end">
                        <form action="/dashboard/teams/{{ team.id }}/registrations/{{ reg.id }}/approve" method="POST">
                          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" />
                          <button type="submit" class="btn btn-success btn-xs gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Approve
                          </button>
                        </form>
                        <form action="/dashboard/teams/{{ team.id }}/registrations/{{ reg.id }}/reject" method="POST">
                          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" />
                          <button type="submit" class="btn btn-error btn-outline btn-xs gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                            Reject
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% endif %}
          </div>
        </div>
        {% endif %}

        <!-- My Registration Status (Parent only) -->
        {% if isParent and myRegistrations.length > 0 %}
        <div class="card bg-base-200 border border-base-300 shadow mt-6">
          <div class="card-body p-5">
            <h2 class="font-heading font-semibold text-lg mb-4">
              My Registration Status
            </h2>

            <div class="space-y-3">
              {% for reg in myRegistrations %}
              <div class="flex items-center justify-between p-3 rounded-lg bg-base-100/50 border border-base-300">
                <div>
                  <p class="font-medium text-sm">
                    {% if reg.child %}
                      {{ reg.child.first_name }} {{ reg.child.last_name }}
                    {% else %}
                      Child
                    {% endif %}
                  </p>
                  <p class="text-base-content/50 text-xs mt-0.5">
                    Requested {{ reg.created_at | truncate(10, true, '') if reg.created_at else 'recently' }}
                  </p>
                </div>
                <div>
                  {% if reg.status === 'pending' %}
                    <span class="badge badge-warning badge-sm gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      Pending
                    </span>
                  {% elif reg.status === 'approved' %}
                    <span class="badge badge-success badge-sm gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      Approved
                    </span>
                  {% elif reg.status === 'rejected' %}
                    <span class="badge badge-error badge-sm gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                      Rejected
                    </span>
                  {% else %}
                    <span class="badge badge-ghost badge-sm">{{ reg.status }}</span>
                  {% endif %}
                </div>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
        {% endif %}
      </div>

    </div>

  </div>
</section>

<!-- Edit Member Modal -->
<dialog id="editMemberModal" class="modal">
  <div class="modal-box w-full max-w-md">
    <h3 class="font-heading font-bold text-lg mb-4">
      Edit <span id="memberNameDisplay" class="text-secondary">Member</span>
    </h3>

    <form id="editMemberForm" method="POST" class="space-y-4">
      <input type="hidden" id="childId" name="child_id" />

      <!-- Skill Level -->
      <div class="form-control">
        <label class="label" for="skillLevel">
          <span class="label-text font-medium">Skill Level</span>
        </label>
        <select 
          id="skillLevel"
          name="skill_level"
          class="select select-bordered"
        >
          <option value="">No Skill Level</option>
          <option value="beginner">Beginner</option>
          <option value="intermediate">Intermediate</option>
          <option value="advanced">Advanced</option>
        </select>
      </div>

      <!-- Position -->
      <div class="form-control">
        <label class="label" for="position">
          <span class="label-text font-medium">Position</span>
        </label>
        <select 
          id="position"
          name="position"
          class="select select-bordered"
        >
          <option value="">No Position</option>
          <option value="Forward">Forward</option>
          <option value="Defenseman">Defenseman</option>
          <option value="Goaltender">Goaltender</option>
        </select>
      </div>

      <!-- Error message -->
      <div id="formError" class="alert alert-error hidden">
        <span id="errorText"></span>
      </div>

      <!-- Action buttons -->
      <div class="modal-action">
        <button 
          type="button"
          class="btn btn-ghost"
          onclick="document.getElementById('editMemberModal').close()"
        >
          Cancel
        </button>
        <button 
          type="submit"
          class="btn btn-secondary gap-2"
          id="submitBtn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Update
        </button>
      </div>
    </form>
  </div>
</dialog>

<script nonce="{{ cspNonce }}">
  const teamId = '{{ team.id }}';

  // Attach event listeners to edit buttons
  document.querySelectorAll('.edit-member-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const childId = btn.dataset.childId;
      const memberName = btn.dataset.childName;
      const skillLevel = btn.dataset.skillLevel;
      const position = btn.dataset.position;

      openEditMemberModal(childId, memberName, skillLevel, position);
    });
  });

  function openEditMemberModal(childId, memberName, skillLevel, position) {
    document.getElementById('childId').value = childId;
    document.getElementById('memberNameDisplay').textContent = memberName;
    document.getElementById('skillLevel').value = skillLevel || '';
    document.getElementById('position').value = position || '';
    document.getElementById('formError').classList.add('hidden');
    document.getElementById('editMemberForm').reset();
    // Re-set values after reset
    document.getElementById('skillLevel').value = skillLevel || '';
    document.getElementById('position').value = position || '';
    document.getElementById('editMemberModal').showModal();
  }

  document.getElementById('editMemberForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const childId = document.getElementById('childId').value;
    const skillLevel = document.getElementById('skillLevel').value;
    const position = document.getElementById('position').value;

    const submitBtn = document.getElementById('submitBtn');
    const originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span>Updating...';

    try {
      // Use relative URL — the frontend server (Express on :4000) will 
      // forward this through apiRequest to the backend (:3000)
      const response = await fetch(
        `/api/children/${childId}/team-details`,
        {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            skill_level: skillLevel || null,
            position: position || null,
          }),
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Failed to update member');
      }

      // Success — close modal and reload page
      document.getElementById('editMemberModal').close();
      window.location.reload();
    } catch (error) {
      console.error('Error updating member:', error);
      document.getElementById('formError').classList.remove('hidden');
      document.getElementById('errorText').textContent = error.message || 'An error occurred. Please try again.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
    }
  });
</script>
{% endblock %}
