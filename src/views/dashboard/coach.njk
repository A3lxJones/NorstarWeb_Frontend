{% extends "layouts/base.njk" %}

{% block content %}
{% include "partials/impersonation-banner.njk" %}

<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-6xl">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="font-heading text-3xl font-bold">
          Coach Dashboard<span class="text-secondary">.</span>
        </h1>
        <h2>Welcome back, {{ user.name }}!</h2>
        <p class="text-base-content/60 mt-1">Manage your teams and games</p>
      </div>
    </div>

    {% if error %}
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{{ error }}</span>
    </div>
    {% endif %}

    <!-- Stats overview -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="stat bg-base-200 border border-base-300 rounded-box p-4">
        <div class="stat-title text-xs">Teams</div>
        <div class="stat-value text-2xl text-secondary">{{ teams | length }}</div>
      </div>
      <div class="stat bg-base-200 border border-base-300 rounded-box p-4">
        <div class="stat-title text-xs">Upcoming Games</div>
        <div class="stat-value text-2xl text-secondary">{{ games | length }}</div>
      </div>
      <div class="stat bg-base-200 border border-base-300 rounded-box p-4">
        <div class="stat-title text-xs">Availability Requests</div>
        <div class="stat-value text-2xl text-secondary">{{ availabilityCount }}</div>
      </div>
    </div>

    <!-- Resources — Availability Requests CTA -->
    <a href="/dashboard/availability"
       class="card bg-gradient-to-r from-accent/10 via-base-200 to-secondary/10 border border-accent/20 shadow-lg hover:shadow-xl hover:border-accent/40 transition-all duration-300 hover:scale-[1.01] mb-4 group scroll-reveal opacity-0">
      <div class="card-body p-5 flex-row items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-accent/20 flex items-center justify-center shrink-0 group-hover:bg-accent/30 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="font-heading font-semibold text-lg group-hover:text-accent transition-colors">
            Availability Requests
          </h3>
          <p class="text-sm text-base-content/50">
            Check who's available for training &amp; matches — send requests to parents and track responses
          </p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/30 group-hover:text-accent group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>

    <!-- Resources — Drill Library CTA -->
    <a href="/dashboard/drills"
       class="card bg-gradient-to-r from-secondary/10 via-base-200 to-accent/10 border border-secondary/20 shadow-lg hover:shadow-xl hover:border-secondary/40 transition-all duration-300 hover:scale-[1.01] mb-4 group scroll-reveal opacity-0">
      <div class="card-body p-5 flex-row items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-secondary/20 flex items-center justify-center shrink-0 group-hover:bg-secondary/30 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="font-heading font-semibold text-lg group-hover:text-secondary transition-colors">
            Drill Library
          </h3>
          <p class="text-sm text-base-content/50">
            Browse hundreds of inline hockey drills — filtered by skill category, difficulty &amp; age group
          </p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/30 group-hover:text-secondary group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>

    <!-- Resources — Calendar CTA -->
    <a href="/dashboard/calendar"
       class="card bg-gradient-to-r from-info/10 via-base-200 to-secondary/10 border border-info/20 shadow-lg hover:shadow-xl hover:border-info/40 transition-all duration-300 hover:scale-[1.01] mb-8 group scroll-reveal opacity-0">
      <div class="card-body p-5 flex-row items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-info/20 flex items-center justify-center shrink-0 group-hover:bg-info/30 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="font-heading font-semibold text-lg group-hover:text-info transition-colors">
            Team Calendar
          </h3>
          <p class="text-sm text-base-content/50">
            View and manage matches, training sessions, and events across all your teams
          </p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/30 group-hover:text-info group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>

    <div class="grid gap-8 lg:grid-cols-2">

      <!-- Teams section -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-heading text-xl font-semibold">Your Teams</h2>
        </div>

        {% if teams.length === 0 %}
        <div class="card bg-base-200 border border-base-300">
          <div class="card-body text-center py-8">
            <p class="text-base-content/60">No teams assigned yet.</p>
          </div>
        </div>
        {% else %}
        <div class="space-y-3">
          {% for team in teams %}
          <div class="card bg-base-200 border border-base-300 shadow hover:shadow-md transition-shadow">
            <div class="card-body p-4">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="font-heading font-semibold">{{ team.name }}</h3>
                  <p class="text-sm text-base-content/60">
                    {{ team.age_group }}
                    {% if team.max_players %}· Max {{ team.max_players }} players{% endif %}
                  </p>
                </div>
                <a href="/dashboard/teams/{{ team.id }}" class="btn btn-ghost btn-sm">
                  View
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <!-- Games section -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-heading text-xl font-semibold">Upcoming Games</h2>
        </div>

        {% if games.length === 0 %}
        <div class="card bg-base-200 border border-base-300">
          <div class="card-body text-center py-8">
            <p class="text-base-content/60">No upcoming games scheduled.</p>
          </div>
        </div>
        {% else %}
        <div class="space-y-3">
          {% for game in games %}
          <div class="card bg-base-200 border border-base-300 shadow hover:shadow-md transition-shadow">
            <div class="card-body p-4">
              <div class="flex items-center justify-between">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="badge badge-sm {% if game.type === 'match' %}badge-primary{% else %}badge-accent{% endif %}">
                      {{ game.type }}
                    </span>
                    <h3 class="font-heading font-semibold">
                      {% if game.opponent %}vs {{ game.opponent }}{% else %}{{ game.type | title }}{% endif %}
                    </h3>
                  </div>
                  <p class="text-sm text-base-content/60 mt-1">
                    📅 {{ game.date }} · 📍 {{ game.location or 'TBC' }}
                  </p>
                </div>
                <a href="/dashboard/games/{{ game.id }}" class="btn btn-ghost btn-sm">
                  Details
                </a>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>

    </div>

  </div>
</section>
{% endblock %}
