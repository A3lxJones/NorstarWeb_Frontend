{% extends "layouts/base.njk" %}

{% block content %}
{% include "partials/impersonation-banner.njk" %}

<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-6xl">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="font-heading text-3xl font-bold">
          Welcome back<span class="text-secondary">!</span>
        </h1>
        <p class="text-base-content/60 mt-1">Manage your children's inline hockey activities</p>
      </div>
      <a href="/dashboard/children/add" class="btn btn-secondary btn-sm gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add Child
      </a>
    </div>

    {% if error %}
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{{ error }}</span>
    </div>
    {% endif %}

    <!-- Calendar CTA -->
    <a href="/dashboard/calendar"
       class="card bg-gradient-to-r from-info/10 via-base-200 to-secondary/10 border border-info/20 shadow-lg hover:shadow-xl hover:border-info/40 transition-all duration-300 hover:scale-[1.01] mb-8 group scroll-reveal opacity-0">
      <div class="card-body p-5 flex-row items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-info/20 flex items-center justify-center shrink-0 group-hover:bg-info/30 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="font-heading font-semibold text-lg group-hover:text-info transition-colors">
            Team Calendar
          </h3>
          <p class="text-sm text-base-content/50">
            View upcoming matches, training sessions, and events for your children's teams
          </p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/30 group-hover:text-info group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>

    <!-- New Joiners Section -->
    <div class="mt-10">
      <h2 class="font-heading text-2xl font-bold mb-2">
        New to Norstar<span class="text-secondary">?</span>
      </h2>
      <p class="text-base-content/60 mb-6">Welcome! Here are the forms and information you need to get started</p>

      <div class="grid gap-4 md:grid-cols-2">
        <!-- Welcome Letter -->
        <a href="/documents/WelcomeLetter.pdf" target="_blank" rel="noopener noreferrer"
           class="card bg-gradient-to-br from-accent/10 via-base-200 to-accent/5 border border-accent/20 shadow-lg hover:shadow-xl hover:border-accent/40 transition-all duration-300 hover:scale-[1.02] group scroll-reveal opacity-0">
          <div class="card-body p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-accent/20 flex items-center justify-center shrink-0 group-hover:bg-accent/30 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="font-heading font-semibold text-lg group-hover:text-accent transition-colors">
                  Welcome Letter
                </h3>
                <p class="text-sm text-base-content/60 mt-1">
                  Download our welcome pack with club information and expectations
                </p>
              </div>
            </div>
          </div>
        </a>

        <!-- Parent Agreement Form -->
        <a href="https://docs.google.com/forms/d/e/1FAIpQLScVRKtPwO7Bh2tmfubT1xCBQJ3PSlNPGI3YQTwkdQ7V_OGf2A/viewform" target="_blank" rel="noopener noreferrer"
           class="card bg-gradient-to-br from-secondary/10 via-base-200 to-secondary/5 border border-secondary/20 shadow-lg hover:shadow-xl hover:border-secondary/40 transition-all duration-300 hover:scale-[1.02] group scroll-reveal opacity-0">
          <div class="card-body p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-secondary/20 flex items-center justify-center shrink-0 group-hover:bg-secondary/30 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="font-heading font-semibold text-lg group-hover:text-secondary transition-colors">
                  Parent Charter
                </h3>
                <p class="text-sm text-base-content/60 mt-1">
                  Please read and sign our parent charter form
                </p>
              </div>
            </div>
          </div>
        </a>

        <!-- Medical & Consent Form -->
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSdSHQnFsBZfPUB0dcF_fy-RjNQQSupe_zcafjd_NtOE6qvQRw/viewform" target="_blank" rel="noopener noreferrer"
           class="card bg-gradient-to-br from-warning/10 via-base-200 to-warning/5 border border-warning/20 shadow-lg hover:shadow-xl hover:border-warning/40 transition-all duration-300 hover:scale-[1.02] group scroll-reveal opacity-0">
          <div class="card-body p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-warning/20 flex items-center justify-center shrink-0 group-hover:bg-warning/30 transition-colors">
                <svg xmlns="https://docs.google.com/forms/d/e/1FAIpQLSdSHQnFsBZfPUB0dcF_fy-RjNQQSupe_zcafjd_NtOE6qvQRw/viewform" class="h-6 w-6 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="font-heading font-semibold text-lg group-hover:text-warning transition-colors">
                  Medical & Club Form
                </h3>
                <p class="text-sm text-base-content/60 mt-1">
                  Provide medical information, allergies, and media consent details
                </p>
              </div>
            </div>
          </div>
        </a>

        <!-- Equipment Information -->
        <a href="https://ihi.vensport.com/memberships" target="_blank" rel="noopener noreferrer"
           class="card bg-gradient-to-br from-success/10 via-base-200 to-success/5 border border-success/20 shadow-lg hover:shadow-xl hover:border-success/40 transition-all duration-300 hover:scale-[1.02] group scroll-reveal opacity-0">
          <div class="card-body p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-success/20 flex items-center justify-center shrink-0 group-hover:bg-success/30 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="font-heading font-semibold text-lg group-hover:text-success transition-colors">
                  Inline Hockey Ireland Registration
                </h3>
                <p class="text-sm text-base-content/60 mt-1">
                  Get registered with Inline Hockey Ireland to play and train in our leagues and tournaments
                </p>
              </div>
            </div>
          </div>
        </a>
      </div>

      <!-- Helpful Info -->
      <div class="card bg-base-200 border border-base-300 shadow-lg mt-6 scroll-reveal opacity-0">
        <div class="card-body">
          <h3 class="font-heading font-semibold text-lg mb-3">Questions?</h3>
          <p class="text-base-content/60 text-sm mb-4">
            If you have any questions about getting started or need help, please reach out to us:
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/contact" class="btn btn-secondary btn-sm gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Contact Us
            </a>
            <a href="https://www.norstarih.com" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-secondary btn-sm gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              Visit Website
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Children list -->
    {% if children.length === 0 %}
    <div class="card bg-base-200 border border-base-300 shadow-lg">
      <div class="card-body items-center text-center py-16">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-base-content/20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <h2 class="font-heading text-xl font-semibold mb-2">No children registered yet</h2>
        <p class="text-base-content/60 mb-4">Add your child to get started with team registration and availability.</p>
        <a href="/dashboard/children/add" class="btn btn-secondary">Add Your First Child</a>
      </div>
    </div>
    {% else %}
    <div class="grid gap-6 md:grid-cols-2">
      {% for child in children %}
      <div class="card bg-base-200 border border-base-300 shadow-lg hover:shadow-xl transition-shadow">
        <div class="card-body">
          <div class="flex items-start justify-between">
            <div>
              <h2 class="card-title font-heading text-lg">
                {{ child.first_name }} {{ child.last_name }}
              </h2>
              <p class="text-base-content/60 text-sm">
                DOB: {{ child.date_of_birth }}
                {% if child.position %}
                  · {{ child.position | capitalize }}
                {% endif %}
              </p>
            </div>
            <div class="dropdown dropdown-end">
              <label tabindex="0" class="btn btn-ghost btn-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01" />
                </svg>
              </label>
              <ul tabindex="0" class="dropdown-content menu p-2 shadow-lg bg-base-300 rounded-box w-48 z-50">
                <li><a href="/dashboard/children/{{ child.id }}">View Details</a></li>
                <li><a href="/dashboard/children/{{ child.id }}/edit">Edit</a></li>
                <li><a href="/dashboard/children/{{ child.id }}/availability">Set Availability</a></li>
              </ul>
            </div>
          </div>

          <div class="divider my-2"></div>

          <div class="grid grid-cols-2 gap-3 text-sm">
            <div>
              <span class="text-base-content/50 text-xs uppercase tracking-wide">Emergency Contact</span>
              <p class="font-medium">{{ child.emergency_contact_name }}</p>
              <p class="text-base-content/60">{{ child.emergency_contact_phone }}</p>
            </div>
            <div>
              <span class="text-base-content/50 text-xs uppercase tracking-wide">Consent</span>
              <p class="flex items-center gap-1">
                {% if child.photo_consent %}
                  <span class="badge badge-success badge-xs"></span> Photo consent given
                {% else %}
                  <span class="badge badge-warning badge-xs"></span> No photo consent
                {% endif %}
              </p>
            </div>
          </div>

          {% if child.medical_conditions or child.allergies %}
          <div class="mt-3 p-3 bg-warning/10 rounded-lg text-sm">
            {% if child.medical_conditions %}
              <p><strong>Medical:</strong> {{ child.medical_conditions }}</p>
            {% endif %}
            {% if child.allergies %}
              <p><strong>Allergies:</strong> {{ child.allergies }}</p>
            {% endif %}
          </div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <!-- ─── Availability Requests ────────────────────────── -->
    {% if availabilityRequests.length > 0 %}
    <div class="mt-10">
      <h2 class="font-heading text-2xl font-bold mb-2">
        Availability Requests<span class="text-secondary">.</span>
      </h2>
      <p class="text-base-content/60 mb-6">Your coach needs to know if your child can make it</p>

      <div class="space-y-4">
        {% for req in availabilityRequests %}
        <div class="card bg-base-200 border border-secondary/20 shadow-lg scroll-reveal opacity-0">
          <div class="card-body p-5">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <span class="badge badge-sm {% if req.request_type === 'match' %}badge-primary{% elif req.request_type === 'training' %}badge-accent{% else %}badge-ghost{% endif %}">
                    {% if req.request_type === 'other' and req.custom_request_type %}
                      {{ req.custom_request_type }}
                    {% else %}
                      {{ req.request_type | capitalize }}
                    {% endif %}
                  </span>
                  {% if req.team_name %}
                  <span class="text-xs text-base-content/40">{{ req.team_name }}</span>
                  {% endif %}
                </div>
                <h3 class="font-heading font-semibold text-lg">{{ req.title }}</h3>
                <p class="text-sm text-base-content/60 mt-1">
                  📅 {{ req.event_date }}
                  {% if req.deadline %}
                    · ⏰ Respond by {{ req.deadline }}
                  {% endif %}
                </p>
                {% if req.notes %}
                <p class="text-sm text-base-content/50 mt-2 italic">{{ req.notes }}</p>
                {% endif %}
              </div>
            </div>

            <!-- Response forms per child -->
            {% if req.children and req.children.length > 0 %}
            <div class="divider my-3 text-xs text-base-content/40">RESPOND FOR YOUR CHILDREN</div>
            <div class="space-y-3">
              {% for child in req.children %}
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-3 bg-base-300/50 rounded-lg">
                <div>
                  <span class="font-medium">{{ child.first_name }} {{ child.last_name }}</span>
                  {% if child.current_status %}
                    <span class="ml-2 badge badge-sm
                      {% if child.current_status === 'available' %}badge-success
                      {% elif child.current_status === 'unavailable' %}badge-error
                      {% elif child.current_status === 'tentative' %}badge-warning
                      {% endif %}">
                      {{ child.current_status | capitalize }}
                    </span>
                  {% endif %}
                </div>

                {% if not child.current_status %}
                <div class="availability-response-row flex gap-2 flex-wrap" data-request-id="{{ req.id }}" data-child-id="{{ child.id }}" data-current-status="">
                  <button type="button" data-status="available"
                          class="btn btn-success btn-xs gap-1 availability-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Available
                  </button>
                  <button type="button" data-status="tentative"
                          class="btn btn-warning btn-xs gap-1 availability-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01" />
                    </svg>
                    Maybe
                  </button>
                  <button type="button" data-status="unavailable"
                          class="btn btn-error btn-xs gap-1 availability-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Unavailable
                  </button>
                </div>
                {% else %}
                <div class="availability-response-row flex gap-2 flex-wrap" data-request-id="{{ req.id }}" data-child-id="{{ child.id }}" data-current-status="{{ child.current_status }}">
                  <span class="badge badge-sm
                    {% if child.current_status === 'available' %}badge-success
                    {% elif child.current_status === 'unavailable' %}badge-error
                    {% elif child.current_status === 'tentative' %}badge-warning
                    {% endif %} current-status-badge">
                    {{ child.current_status | capitalize }}
                  </span>

                  {% if child.current_status !== 'available' %}
                  <button type="button" data-status="available" class="btn btn-success btn-xs btn-outline gap-1 availability-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    Available
                  </button>
                  {% endif %}
                  {% if child.current_status !== 'tentative' %}
                  <button type="button" data-status="tentative" class="btn btn-warning btn-xs btn-outline gap-1 availability-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01" /></svg>
                    Maybe
                  </button>
                  {% endif %}
                  {% if child.current_status !== 'unavailable' %}
                  <button type="button" data-status="unavailable" class="btn btn-error btn-xs btn-outline gap-1 availability-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    Unavailable
                  </button>
                  {% endif %}
                </div>
                {% endif %}
              </div>
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

  </div>
</section>
{% endblock %}

{% block scripts %}
<script nonce="{{ cspNonce }}">
(function () {
  var STATUS_CONFIG = {
    available:   { badge: 'badge-success', label: 'Available' },
    tentative:   { badge: 'badge-warning', label: 'Maybe' },
    unavailable: { badge: 'badge-error',   label: 'Unavailable' }
  };

  /* ── Toast helper ────────────────────────────────── */
  function showToast(message, type) {
    var container = document.getElementById('toast-container');
    if (!container) return;

    var alertClass = type === 'error' ? 'alert-error' : 'alert-success';
    var alert = document.createElement('div');
    alert.className = 'alert ' + alertClass + ' shadow-lg text-sm py-3 px-4 animate-fade-in';
    alert.innerHTML =
      '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">' +
        (type === 'error'
          ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />'
          : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />') +
      '</svg>' +
      '<span>' + message + '</span>';

    container.appendChild(alert);

    setTimeout(function () {
      alert.style.opacity = '0';
      alert.style.transition = 'opacity 0.3s ease';
      setTimeout(function () { alert.remove(); }, 300);
    }, 4000);
  }

  /* ── Rebuild the button row after a status change ── */
  function rebuildRow(row, newStatus) {
    row.dataset.currentStatus = newStatus;
    row.innerHTML = '';

    // Status badge
    var cfg = STATUS_CONFIG[newStatus];
    var badge = document.createElement('span');
    badge.className = 'badge badge-sm ' + cfg.badge + ' current-status-badge';
    badge.textContent = cfg.label;
    row.appendChild(badge);

    // Change-buttons for the other two statuses
    var allStatuses = ['available', 'tentative', 'unavailable'];
    allStatuses.forEach(function (s) {
      if (s === newStatus) return;
      var btnCfg = STATUS_CONFIG[s];
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.status = s;
      btn.className = 'btn btn-xs btn-outline gap-1 availability-btn btn-' +
        (s === 'available' ? 'success' : s === 'tentative' ? 'warning' : 'error');
      btn.textContent = btnCfg.label;
      row.appendChild(btn);
    });
  }

  /* ── Delegate click on any availability button ───── */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.availability-btn');
    if (!btn) return;

    var row = btn.closest('.availability-response-row');
    if (!row) return;

    var requestId = row.dataset.requestId;
    var childId   = row.dataset.childId;
    var status    = btn.dataset.status;

    if (!requestId || !childId || !status) return;

    // Disable buttons while in flight
    var buttons = row.querySelectorAll('.availability-btn');
    buttons.forEach(function (b) { b.disabled = true; b.classList.add('loading', 'loading-xs'); });

    fetch('/dashboard/availability/' + encodeURIComponent(requestId) + '/respond', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ child_id: childId, status: status })
    })
    .then(function (res) { return res.json(); })
    .then(function (data) {
      if (data.success) {
        rebuildRow(row, status);
        showToast('Thank you for responding! Your availability has been recorded.', 'success');
      } else {
        showToast(data.error || 'Something went wrong. Please try again.', 'error');
        buttons.forEach(function (b) { b.disabled = false; b.classList.remove('loading', 'loading-xs'); });
      }
    })
    .catch(function () {
      showToast('Network error — please check your connection and try again.', 'error');
      buttons.forEach(function (b) { b.disabled = false; b.classList.remove('loading', 'loading-xs'); });
    });
  });
})();
</script>
{% endblock %}
