{% extends "layouts/base.njk" %}

{% block content %}
{% include "partials/impersonation-banner.njk" %}

<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-6xl">

    <!-- Breadcrumb -->
    <div class="text-sm breadcrumbs mb-6">
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li class="text-base-content/60">Availability Requests</li>
      </ul>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="font-heading text-3xl font-bold">
          Availability Requests<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/60 mt-1">Check who's available for training &amp; matches</p>
      </div>
      <a href="/dashboard/availability/create" class="btn btn-secondary btn-sm gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        New Request
      </a>
    </div>

    {% if error %}
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{{ error }}</span>
    </div>
    {% endif %}

    {% if requests.length === 0 %}
    <div class="card bg-base-200 border border-base-300 shadow-lg">
      <div class="card-body items-center text-center py-16">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-base-content/20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <h2 class="font-heading text-xl font-semibold mb-2">No availability requests yet</h2>
        <p class="text-base-content/60 mb-4">Create a request to check which players are available for an upcoming event.</p>
        <a href="/dashboard/availability/create" class="btn btn-secondary">Create First Request</a>
      </div>
    </div>
    {% else %}
    <div class="space-y-4">
      {% for req in requests %}
      <a href="/dashboard/availability/{{ req.id }}" class="card bg-base-200 border border-base-300 shadow hover:shadow-lg hover:border-secondary/30 transition-all duration-200 block group">
        <div class="card-body p-5">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="badge badge-sm {% if req.request_type === 'match' %}badge-primary{% elif req.request_type === 'training' %}badge-accent{% else %}badge-ghost{% endif %}">
                  {% if req.request_type === 'other' and req.custom_request_type %}
                    {{ req.custom_request_type }}
                  {% else %}
                    {{ req.request_type | capitalize }}
                  {% endif %}
                </span>
                {% if req.team_name %}
                <span class="text-xs text-base-content/40">{{ req.team_name }}</span>
                {% endif %}
              </div>
              <h3 class="font-heading font-semibold text-lg group-hover:text-secondary transition-colors">
                {{ req.title }}
              </h3>
              <p class="text-sm text-base-content/60 mt-1">
                📅 {{ req.event_date }}
                {% if req.deadline %}
                  · ⏰ Deadline: {{ req.deadline }}
                {% endif %}
              </p>
            </div>

            {% if req.response_summary %}
            <div class="flex gap-3 text-center">
              <div class="flex flex-col items-center">
                <span class="text-lg font-bold text-success">{{ req.response_summary.available }}</span>
                <span class="text-xs text-base-content/40">Yes</span>
              </div>
              <div class="flex flex-col items-center">
                <span class="text-lg font-bold text-error">{{ req.response_summary.unavailable }}</span>
                <span class="text-xs text-base-content/40">No</span>
              </div>
              <div class="flex flex-col items-center">
                <span class="text-lg font-bold text-warning">{{ req.response_summary.tentative }}</span>
                <span class="text-xs text-base-content/40">Maybe</span>
              </div>
              <div class="flex flex-col items-center">
                <span class="text-lg font-bold text-base-content/30">{{ req.response_summary.pending }}</span>
                <span class="text-xs text-base-content/40">Pending</span>
              </div>
            </div>
            {% endif %}

            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/30 group-hover:text-secondary group-hover:translate-x-1 transition-all shrink-0 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
    {% endif %}

  </div>
</section>
{% endblock %}
