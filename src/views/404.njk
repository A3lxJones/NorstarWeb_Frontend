{% extends "layouts/base.njk" %}

{% block content %}

<section class="min-h-[80vh] flex items-center justify-center bg-base-200/40">

  <div class="relative z-10 text-center px-4 max-w-2xl mx-auto py-16">
    <!-- Large 404 -->
    <div class="scroll-reveal opacity-0 relative mb-6">
      <h1 class="font-heading text-[10rem] md:text-[14rem] font-bold text-secondary/10 leading-none select-none">404</h1>
      
      <div class="absolute inset-0 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 text-secondary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M12 2a10 10 0 110 20 10 10 0 010-20z" />
        </svg>
      </div>
    </div>

    <h2 class="scroll-reveal opacity-0 font-heading text-2xl md:text-4xl font-bold mb-4">
      This Puck Went <span class="text-secondary">Wide</span>
    </h2>
    <p class="scroll-reveal opacity-0 text-base-content/60 mb-10 max-w-md mx-auto text-lg">
      The page you're looking for has been checked into the boards. It might have been moved, removed, or never existed.
    </p>

    <!-- Action buttons -->
    <div class="scroll-reveal opacity-0 flex flex-col sm:flex-row gap-3 justify-center mb-16">
      <a href="/" class="btn btn-secondary gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Back to Home
      </a>
      <a href="/contact" class="btn btn-outline btn-secondary gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Contact Us
      </a>
    </div>

    <!-- Suggested pages -->
    <div class="scroll-reveal opacity-0">
      <p class="text-sm text-base-content/40 mb-4 font-medium uppercase tracking-wider">Try these instead</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-lg mx-auto">
        <a href="/fixtures" class="group p-4 rounded-xl bg-base-200/50 border border-base-300/50 hover:border-secondary/30 hover:bg-base-200 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mx-auto mb-2 text-base-content/40 group-hover:text-secondary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="text-xs font-medium text-base-content/60 group-hover:text-secondary transition-colors">Fixtures</span>
        </a>
        <a href="/news" class="group p-4 rounded-xl bg-base-200/50 border border-base-300/50 hover:border-secondary/30 hover:bg-base-200 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mx-auto mb-2 text-base-content/40 group-hover:text-secondary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <span class="text-xs font-medium text-base-content/60 group-hover:text-secondary transition-colors">News</span>
        </a>
        <a href="/contact" class="group p-4 rounded-xl bg-base-200/50 border border-base-300/50 hover:border-secondary/30 hover:bg-base-200 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mx-auto mb-2 text-base-content/40 group-hover:text-secondary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="text-xs font-medium text-base-content/60 group-hover:text-secondary transition-colors">Contact</span>
        </a>
        <a href="/login" class="group p-4 rounded-xl bg-base-200/50 border border-base-300/50 hover:border-secondary/30 hover:bg-base-200 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mx-auto mb-2 text-base-content/40 group-hover:text-secondary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span class="text-xs font-medium text-base-content/60 group-hover:text-secondary transition-colors">Login</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% endblock %}
