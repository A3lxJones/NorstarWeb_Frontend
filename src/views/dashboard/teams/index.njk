{% extends "layouts/base.njk" %}

{% block content %}
<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-5xl">

    <!-- Breadcrumb -->
    <div class="text-sm breadcrumbs mb-6">
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li class="text-base-content/60">Teams</li>
      </ul>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="font-heading text-3xl font-bold">
          Teams<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/60 mt-1">All Norstar inline hockey teams</p>
      </div>
      {% if canCreate %}
      <a href="/dashboard/teams/create" class="btn btn-secondary btn-sm gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Create Team
      </a>
      {% endif %}
    </div>

    {% if error %}
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{{ error }}</span>
    </div>
    {% endif %}

    {% if teams.length === 0 %}
    <div class="card bg-base-200 border border-base-300 shadow-lg">
      <div class="card-body items-center text-center py-16">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-base-content/20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <h2 class="font-heading text-xl font-semibold mb-2">No teams yet</h2>
        <p class="text-base-content/60 mb-4">Teams will appear here once they are created.</p>
        {% if canCreate %}
        <a href="/dashboard/teams/create" class="btn btn-secondary">Create First Team</a>
        {% endif %}
      </div>
    </div>
    {% else %}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {% for team in teams %}
      <a href="/dashboard/teams/{{ team.id }}" class="card bg-base-200 border border-base-300 shadow hover:shadow-lg transition-all hover:-translate-y-0.5 group">
        <div class="card-body p-5">
          <div class="flex items-start justify-between">
            <div>
              <h2 class="card-title font-heading text-lg group-hover:text-secondary transition-colors">
                {{ team.name }}
              </h2>
              <p class="text-base-content/60 text-sm mt-1">{{ team.age_group }}</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/30 group-hover:text-secondary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>

          <div class="divider my-2"></div>

          <div class="flex items-center justify-between text-sm">
            {% if team.coach %}
            <div class="flex items-center gap-2 text-base-content/60">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span>{{ team.coach.full_name }}</span>
            </div>
            {% else %}
            <span class="text-base-content/40 text-xs">No coach assigned</span>
            {% endif %}

            {% if team.max_players %}
            <span class="badge badge-outline badge-sm">Max {{ team.max_players }}</span>
            {% endif %}
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
    {% endif %}

  </div>
</section>
{% endblock %}
