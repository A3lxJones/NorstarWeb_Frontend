{% extends "layouts/base.njk" %}

{% block content %}
<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-4xl">

    <!-- Breadcrumb -->
    <div class="text-sm breadcrumbs mb-6">
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/dashboard/teams">Teams</a></li>
        <li class="text-base-content/60">{{ team.name }}</li>
      </ul>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="font-heading text-3xl font-bold">
          {{ team.name }}<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/60 mt-1">{{ team.age_group }}
          {% if team.max_players %} · Max {{ team.max_players }} players{% endif %}
        </p>
      </div>
      {% if canEdit %}
      <div class="flex gap-2">
        <a href="/dashboard/teams/{{ team.id }}/edit" class="btn btn-outline btn-sm gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit
        </a>
      </div>
      {% endif %}
    </div>

    <div class="grid gap-8 lg:grid-cols-3">

      <!-- Team Info -->
      <div class="lg:col-span-1">
        <div class="card bg-base-200 border border-base-300 shadow">
          <div class="card-body p-5">
            <h2 class="font-heading font-semibold text-lg mb-3">Team Info</h2>

            <div class="space-y-3 text-sm">
              <div>
                <span class="text-base-content/50 text-xs uppercase tracking-wide">Age Group</span>
                <p class="font-medium">{{ team.age_group }}</p>
              </div>

              {% if team.coach %}
              <div>
                <span class="text-base-content/50 text-xs uppercase tracking-wide">Coach</span>
                <p class="font-medium">{{ team.coach.full_name }}</p>
                <p class="text-base-content/60 text-xs">{{ team.coach.email }}</p>
              </div>
              {% endif %}

              {% if team.max_players %}
              <div>
                <span class="text-base-content/50 text-xs uppercase tracking-wide">Roster Limit</span>
                <p class="font-medium">{{ team.members | length }} / {{ team.max_players }}</p>
              </div>
              {% else %}
              <div>
                <span class="text-base-content/50 text-xs uppercase tracking-wide">Players</span>
                <p class="font-medium">{{ team.members | length }}</p>
              </div>
              {% endif %}

              <div>
                <span class="text-base-content/50 text-xs uppercase tracking-wide">Created</span>
                <p class="font-medium">{{ team.created_at | truncate(10, true, '') }}</p>
              </div>
            </div>
          </div>
        </div>

        {% if canEdit %}
        <div class="mt-4">
          <form action="/dashboard/teams/{{ team.id }}/delete" method="POST"
                onsubmit="return confirm('Are you sure you want to delete this team? This cannot be undone.')">
            <button type="submit" class="btn btn-error btn-outline btn-sm btn-block gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              Delete Team
            </button>
          </form>
        </div>
        {% endif %}
      </div>

      <!-- Members -->
      <div class="lg:col-span-2">
        <div class="card bg-base-200 border border-base-300 shadow">
          <div class="card-body p-5">
            <h2 class="font-heading font-semibold text-lg mb-4">
              Approved Members
              <span class="badge badge-secondary badge-sm ml-2">{{ team.members | length }}</span>
            </h2>

            {% if team.members.length === 0 %}
            <div class="text-center py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/20 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <p class="text-base-content/60 text-sm">No approved members yet.<br>Parents can register their children for this team.</p>
            </div>
            {% else %}
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>DOB</th>
                    <th>Skill Level</th>
                    <th>Position</th>
                  </tr>
                </thead>
                <tbody>
                  {% for reg in team.members %}
                  <tr class="hover">
                    <td class="font-medium">{{ reg.child.first_name }} {{ reg.child.last_name }}</td>
                    <td class="text-base-content/60">{{ reg.child.date_of_birth }}</td>
                    <td>
                      {% if reg.child.skill_level %}
                        <span class="badge badge-outline badge-sm">{{ reg.child.skill_level }}</span>
                      {% else %}
                        <span class="text-base-content/40">—</span>
                      {% endif %}
                    </td>
                    <td>{{ reg.child.position or '—' }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% endif %}
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
{% endblock %}
