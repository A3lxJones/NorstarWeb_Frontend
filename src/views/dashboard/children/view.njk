{% extends "layouts/base.njk" %}

{% block content %}
<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-3xl">

    <!-- Back link -->
    <a href="{{ backUrl | default('/dashboard') }}" class="btn btn-ghost btn-sm gap-1 mb-6 -ml-2 text-base-content/60 hover:text-secondary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      {{ backLabel | default('Back') }}
    </a>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="font-heading text-3xl font-bold">
        {{ child.first_name }} {{ child.last_name }}<span class="text-secondary">.</span>
      </h1>
      <p class="text-base-content/60 mt-1">Essential information for coaches and staff</p>
    </div>

    <div class="grid gap-6">

      <!-- Basic Info Card -->
      <div class="card bg-base-200 border border-base-300 shadow-xl">
        <div class="card-body">
          <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            Basic Information
          </h2>

          <div class="space-y-4 text-sm">
            <div>
              <span class="text-base-content/50 text-xs uppercase tracking-wide">Full Name</span>
              <p class="font-medium mt-0.5">{{ child.first_name }} {{ child.last_name }}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Emergency Contact Card -->
      <div class="card bg-base-200 border border-base-300 shadow-xl">
        <div class="card-body">
          <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Emergency Contact
          </h2>

          <div class="space-y-4 text-sm">
            <div>
              <span class="text-base-content/50 text-xs uppercase tracking-wide">Name</span>
              <p class="font-medium mt-0.5">{{ child.emergency_contact_name or '—' }}</p>
            </div>
            <div>
              <span class="text-base-content/50 text-xs uppercase tracking-wide">Phone</span>
              <p class="font-medium mt-0.5">{{ child.emergency_contact_phone or '—' }}</p>
            </div>
            <div>
              <span class="text-base-content/50 text-xs uppercase tracking-wide">Relationship</span>
              <p class="font-medium mt-0.5">{{ child.emergency_contact_relationship | capitalize if child.emergency_contact_relationship else '—' }}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Medical Info Card -->
      <div class="card bg-base-200 border border-base-300 shadow-xl">
        <div class="card-body">
          <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Medical Information
          </h2>

          <div class="space-y-4 text-sm">
            <div>
              <span class="text-base-content/50 text-xs uppercase tracking-wide">Medical Conditions</span>
              <p class="font-medium mt-0.5">{{ child.medical_conditions or 'None reported' }}</p>
            </div>
            <div>
              <span class="text-base-content/50 text-xs uppercase tracking-wide">Allergies</span>
              <p class="font-medium mt-0.5">{{ child.allergies or 'None reported' }}</p>
            </div>
          </div>

          {% if child.medical_conditions or child.allergies %}
          <div class="mt-4 p-3 bg-warning/10 rounded-lg border border-warning/20">
            <p class="text-xs text-warning font-semibold flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              Coaches should be aware of this information
            </p>
          </div>
          {% endif %}
        </div>
      </div>

    </div>

  </div>
</section>
{% endblock %}
