# API transport — OPTIONAL. Leave unset in dev/production: the API now runs
# in-process (src/server-api) with no network hop. Only set this to route
# requests over HTTP to an external API (the e2e suite sets it to the mock
# backend automatically).
# API_URL=http://localhost:3000

# ─── Database (Supabase Postgres) ─────────────────────────────
# Backs the serverless-safe session store. Use the Supabase connection
# POOLER string (port 6543) so serverless functions don't exhaust
# direct connections.
#   Supabase dashboard → Project Settings → Database → Connection pooling
DATABASE_URL=

# ─── Supabase API ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses Row-Level Security — never expose to the browser
# and never prefix with anything client-visible.
SUPABASE_SERVICE_ROLE_KEY=

# Session secret — REQUIRED in production. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password reset redirect (where the email link sends users)
# Must match an allowed redirect URL in Supabase Auth settings
PASSWORD_RESET_REDIRECT_URL=http://localhost:4000/reset-password

# Server
PORT=4000
NODE_ENV=development
