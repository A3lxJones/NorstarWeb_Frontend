{% extends "layouts/base.njk" %}

{% block content %}
<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-6xl">

    <!-- Back link -->
    <a href="/dashboard" class="btn btn-ghost btn-sm gap-1 mb-6 -ml-2 text-base-content/60 hover:text-secondary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Dashboard
    </a>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="font-heading text-3xl font-bold">
        Player Information<span class="text-secondary">.</span>
      </h1>
      <p class="text-base-content/60 mt-1">
        Emergency contacts, medical conditions and allergies for your players.
      </p>
    </div>

    {% if error %}
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{{ error }}</span>
    </div>
    {% endif %}

    <!-- Team filter -->
    <div class="card bg-base-200 border border-base-300 shadow mb-8">
      <div class="card-body p-5">
        <form action="/dashboard/children/roster" method="GET" class="flex flex-col sm:flex-row sm:items-end gap-3">
          <div class="form-control flex-1">
            <label class="label" for="team-filter">
              <span class="label-text font-medium">Filter by team</span>
            </label>
            <select id="team-filter" name="team"
                    class="select select-bordered w-full focus:select-secondary transition-colors">
              <option value="" {% if not selectedTeamId %}selected{% endif %}>All players</option>
              {% for team in teams %}
              <option value="{{ team.id }}" {% if selectedTeamId === team.id %}selected{% endif %}>
                {{ team.name }} ({{ team.age_group }})
              </option>
              {% endfor %}
            </select>
          </div>
          <div class="flex gap-2">
            <button type="submit" class="btn btn-secondary gap-2 hover:scale-[1.02] transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
              </svg>
              Apply
            </button>
            {% if selectedTeamId %}
            <a href="/dashboard/children/roster" class="btn btn-ghost">Clear</a>
            {% endif %}
          </div>
        </form>
      </div>
    </div>

    <!-- Results -->
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-heading text-xl font-semibold">
        {% if selectedTeam %}{{ selectedTeam.name }}{% else %}All players{% endif %}
      </h2>
      <span class="badge badge-secondary badge-sm">{{ children | length }}</span>
    </div>

    {% if children.length === 0 %}
    <div class="card bg-base-200 border border-base-300 shadow-lg">
      <div class="card-body items-center text-center py-12">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 text-base-content/20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <h3 class="font-heading text-xl font-semibold mb-2">No players found</h3>
        <p class="text-base-content/60">
          {% if selectedTeamId %}
            No approved players are registered to this team yet.
          {% else %}
            No children have been registered yet.
          {% endif %}
        </p>
      </div>
    </div>
    {% else %}
    <div class="grid gap-6 md:grid-cols-2">
      {% for child in children %}
      <div class="card bg-base-200 border border-base-300 shadow-lg hover:shadow-xl transition-shadow">
        <div class="card-body">
          <div class="flex items-start justify-between gap-2">
            <h3 class="card-title font-heading text-lg">
              <a href="/dashboard/children/{{ child.id }}/info" class="link link-hover text-secondary">
                {{ child.first_name }} {{ child.last_name }}
              </a>
            </h3>
            {% if child.position %}
            <span class="badge badge-ghost badge-sm">{{ child.position | capitalize }}</span>
            {% endif %}
          </div>

          <div class="divider my-2"></div>

          <div class="text-sm">
            <span class="text-base-content/50 text-xs uppercase tracking-wide">Emergency Contact</span>
            <p class="font-medium mt-0.5">{{ child.emergency_contact_name or '—' }}</p>
            <p class="text-base-content/60">
              {{ child.emergency_contact_phone or '—' }}
              {% if child.emergency_contact_relationship %}
                · {{ child.emergency_contact_relationship | capitalize }}
              {% endif %}
            </p>
          </div>

          <div class="mt-3 p-3 bg-warning/10 rounded-lg text-sm space-y-1">
            <p><strong>Medical:</strong> {{ child.medical_conditions or 'Not provided' }}</p>
            <p><strong>Allergies:</strong> {{ child.allergies or 'Not provided' }}</p>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

  </div>
</section>
{% endblock %}
