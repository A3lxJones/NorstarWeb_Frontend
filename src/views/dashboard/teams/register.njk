{% extends "layouts/base.njk" %}

{% block content %}
<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-2xl">

    <!-- Breadcrumb -->
    <div class="text-sm breadcrumbs mb-6">
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/dashboard/teams">Teams</a></li>
        <li><a href="/dashboard/teams/{{ team.id }}">{{ team.name }}</a></li>
        <li class="text-base-content/60">Register Child</li>
      </ul>
    </div>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="font-heading text-3xl font-bold">
        Register for {{ team.name }}<span class="text-secondary">.</span>
      </h1>
      <p class="text-base-content/60 mt-1">
        {{ team.age_group }}
        {% if team.coach %}
          · Coach: {{ team.coach.full_name }}
        {% endif %}
      </p>
    </div>

    {% if success %}
    <div class="alert alert-success mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{{ success }}</span>
    </div>
    {% endif %}

    {% if error %}
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{{ error }}</span>
    </div>
    {% endif %}

    <!-- Already registered children -->
    {% if registeredChildIds.length > 0 %}
    <div class="card bg-base-200 border border-base-300 shadow mb-6">
      <div class="card-body p-5">
        <h2 class="font-heading font-semibold text-lg mb-3 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          This Child is Already Registered
        </h2>
        <div class="space-y-2">
          {% for child in allChildren %}
            {% if child.id in registeredChildIds %}
            <div class="flex items-center gap-3 p-3 bg-success/10 rounded-lg">
              <span class="badge badge-success badge-sm">Registered</span>
              <span class="font-medium">{{ child.first_name }} {{ child.last_name }}</span>
            </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

    <!-- Register a child -->
    {% if children.length > 0 %}
    <div class="card bg-base-200 border border-base-300 shadow-xl">
      <div class="card-body p-6">
        <h2 class="font-heading font-semibold text-lg mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          Select a Child to Register
        </h2>

        <p class="text-base-content/60 text-sm mb-6">
          Choose which child you'd like to register for this team. The coach will review and approve the registration.
        </p>

        <div class="space-y-3">
          {% for child in children %}
          <form action="/dashboard/teams/{{ team.id }}/register" method="POST">
            <input type="hidden" name="child_id" value="{{ child.id }}" />
            <!-- Honeypot -->
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" />

            <div class="flex items-center justify-between p-4 bg-base-300/50 rounded-lg hover:bg-base-300 transition-colors">
              <div>
                <p class="font-medium">{{ child.first_name }} {{ child.last_name }}</p>
              </div>
              <button type="submit"
                      class="btn btn-secondary btn-sm gap-1 hover:scale-[1.02] transition-all"
                      data-confirm="Register {{ child.first_name }} for {{ team.name }}?">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Register
              </button>
            </div>
          </form>
          {% endfor %}
        </div>
      </div>
    </div>
    {% elif allChildren.length === 0 %}
    <!-- No children at all -->
    <div class="card bg-base-200 border border-base-300 shadow-lg">
      <div class="card-body items-center text-center py-12">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/20 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <h2 class="font-heading text-xl font-semibold mb-2">No children registered</h2>
        <p class="text-base-content/60 mb-4">You need to add a child to your account before registering for a team.</p>
        <a href="/dashboard/children/add" class="btn btn-secondary btn-sm">Add a Child</a>
      </div>
    </div>
    {% else %}
    <!-- All children already registered -->
    <div class="card bg-base-200 border border-success/30 shadow-lg">
      <div class="card-body items-center text-center py-12">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-success/40 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
  <!-- could be an issue here as different children may have different teams-->
        <h2 class="font-heading text-xl font-semibold mb-2">All children registered</h2>
        <!--if a child is registered for a different team, we should show that here instead of saying all children are registered for this team-->
        <!-- needs finished -->
        {% if condition %}
          <p class ="text-base-content/60 mb-4">{{ child.first_name }} {{ child.last_name }} is already registered for {{ different_team.name }}.</p>
        {% endif %}
        <p class ="text-base-content/60 mb-4">{{ child.first_name }} {{ child.last_name }} is already registered for {{ team.name }}.</p>
       
        
        <p class="text-base-content/60 mb-4">All your children are already registered for {{ team.name }}.</p>
        <a href="/dashboard/teams/{{ team.id }}" class="btn btn-outline btn-sm">Back to Team</a>
      </div>
    </div>
    {% endif %}

    <!-- Back button -->
    <div class="mt-6">
      <a href="/dashboard/teams/{{ team.id }}" class="btn btn-ghost btn-sm gap-1 text-base-content/60 hover:text-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to {{ team.name }}
      </a>
    </div>

  </div>
</section>
{% endblock %}
