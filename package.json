{
    "name": "norstar-web-frontend",
    "version": "1.0.0",
    "description": "Norstar Inline Hockey Club - Ballymena - Frontend",
    "main": "dist/server.js",
    "scripts": {
        "build:ts": "tsc",
        "build:css": "npx tailwindcss -i ./src/public/css/input.css -o ./src/public/css/output.css --minify",
        "build": "npm run build:css && npm run build:ts",
        "dev:ts": "tsc --watch",
        "dev:css": "npx tailwindcss -i ./src/public/css/input.css -o ./src/public/css/output.css --watch",
        "dev:server": "nodemon dist/server.js",
        "dev": "concurrently \"npm run dev:css\" \"npm run dev:ts\" \"npm run dev:server\"",
        "start": "node dist/server.js",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "type-check": "tsc --noEmit",
        "test": "npm run type-check && npm run lint && npm run build && npm run test:e2e",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report"
    },
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "inline-hockey",
        "ballymena",
        "norstar"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@supabase/supabase-js": "^2.45.0",
        "connect-pg-simple": "^10.0.0",
        "dotenv": "^17.3.1",
        "express": "^4.21.0",
        "express-async-errors": "^3.1.1",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.19.0",
        "helmet": "^8.1.0",
        "nunjucks": "^3.2.4",
        "pg": "^8.13.0",
        "ws": "^8.21.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@types/connect-pg-simple": "^7.0.3",
        "@types/express": "^4.17.21",
        "@types/express-rate-limit": "^5.1.3",
        "@types/express-session": "^1.18.2",
        "@types/node": "^20.19.43",
        "@types/nunjucks": "^3.2.6",
        "@types/pg": "^8.11.0",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^6.18.1",
        "@typescript-eslint/parser": "^6.18.1",
        "concurrently": "^8.2.2",
        "daisyui": "^4.12.0",
        "eslint": "^8.56.0",
        "nodemon": "^3.0.3",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3"
    }
}