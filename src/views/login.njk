{% extends "layouts/base.njk" %}

{% block content %}

<section class="min-h-[80vh] flex items-center justify-center bg-base-200/40 py-12">

  <div class="relative z-10 w-full max-w-md mx-auto px-4">
    <!-- Login card -->
    <div class="scroll-reveal opacity-0 bg-base-100 border border-base-300 rounded-box">
      <div class="p-8">
        <!-- Header -->
        <div class="text-center mb-6">
          <h1 class="font-heading text-3xl font-bold mb-2">
            <span class="text-secondary">NOR</span>STAR
          </h1>
          <p class="text-base-content/60 text-sm">Sign in to your member account</p>
        </div>

        {% if error %}
        <div class="alert alert-error text-sm mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{{ error }}</span>
        </div>
        {% endif %}

        <!-- Login form -->
        <form action="/login" method="POST" class="space-y-5" novalidate>
          <div class="form-control">
            <label class="label" for="login-email">
              <span class="label-text font-medium">Email Address</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-base-content/40">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </span>
              <input type="email" id="login-email" name="email" placeholder="you@example.com"
                     value="{{ email or '' }}"
                     class="input input-bordered w-full pl-10 focus:input-secondary transition-colors"
                     required autocomplete="email" maxlength="254" />
            </div>
          </div>

          <div class="form-control">
            <label class="label" for="login-password">
              <span class="label-text font-medium">Password</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-base-content/40">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </span>
              <input type="password" id="login-password" name="password" placeholder="•••••••••••••••"
                     class="input input-bordered w-full pl-10 focus:input-secondary transition-colors"
                     required autocomplete="current-password" minlength="8" />
            </div>
            <label class="label">
              <a href="/forgot-password" class="label-text-alt link link-hover text-secondary/70 hover:text-secondary">Forgot password?</a>
            </label>
          </div>

          <!-- Honeypot (anti-bot, hidden from real users) -->
          <div class="hidden" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <!-- Role indicator -->
          <div class="alert bg-base-200 border-base-300 text-xs">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-base-content/60">Members and coaches will see different dashboards based on their role.</span>
          </div>

          <button type="submit" class="btn btn-secondary btn-block font-semibold gap-2">
            Sign In
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
          </button>
        </form>

        <!-- Divider -->
        <div class="divider text-base-content/30 text-xs my-4">NEW HERE?</div>

        <!-- Signup link -->
        <a href="/signup" class="btn btn-ghost btn-sm w-full text-base-content/60 hover:text-secondary">
          Create an account →
        </a>
      </div>
    </div>

    <!-- Security note -->
    <div class="scroll-reveal opacity-0 text-center mt-6" style="animation-delay: 0.2s;">
      <div class="flex flex-col items-center gap-2">
        <p class="text-xs text-base-content/40 flex items-center justify-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          Secured with bcrypt hashing, rate limiting &amp; HTTPS
        </p>
        <div class="flex gap-3 text-[10px] text-base-content/30">
          <span class="flex items-center gap-1">
            <span class="w-1.5 h-1.5 bg-success rounded-full"></span>
            CSP Active
          </span>
          <span class="flex items-center gap-1">
            <span class="w-1.5 h-1.5 bg-success rounded-full"></span>
            HSTS Enabled
          </span>
          <span class="flex items-center gap-1">
            <span class="w-1.5 h-1.5 bg-success rounded-full"></span>
            Rate Limited
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

{% endblock %}
