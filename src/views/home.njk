{% extends "layouts/base.njk" %}

{% block content %}

<!-- ═══════════════════════════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════════════════════════ -->
<section class="hero min-h-[85vh] relative overflow-hidden">
  <!-- Animated background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-base-100 via-primary/20 to-base-100"></div>
  
  <!-- Floating decorative elements -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-secondary/5 rounded-full blur-3xl animate-float"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-accent/5 rounded-full blur-3xl animate-float" style="animation-delay: 1.5s;"></div>
  <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-primary/10 rounded-full blur-3xl animate-float" style="animation-delay: 0.8s;"></div>

  <!-- Grid pattern overlay -->
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #a855f7 1px, transparent 1px); background-size: 40px 40px;"></div>

  <div class="hero-content text-center relative z-10 py-20">
    <div class="max-w-3xl">
      <!-- Club Logo -->
      <div class="scroll-reveal opacity-0 mb-8">
        <div class="mx-auto w-48 h-48 md:w-56 md:h-56 flex items-center justify-center">
          <img src="/images/Norstar.png" alt="Norstar Inline Hockey Club Logo" class="w-full h-full object-contain drop-shadow-2xl hover:scale-105 transition-transform duration-300" />
        </div>
      </div>

      <!-- Badge -->
      <div class="scroll-reveal opacity-0 mb-6">
        <span class="badge badge-secondary badge-outline badge-lg gap-2 font-medium">
          ⛸️ Ballymena's Home of Inline Hockey
        </span>
      </div>

      <!-- Main heading -->
      <h1 class="scroll-reveal opacity-0 font-heading text-5xl md:text-7xl lg:text-8xl font-bold leading-tight mb-6" style="animation-delay: 0.15s;">
        <span class="text-secondary">NOR</span><span class="text-base-content">STAR</span>
        <br />
        <span class="text-3xl md:text-4xl lg:text-5xl font-medium text-base-content/70">INLINE HOCKEY</span>
      </h1>

      <!-- Subtitle -->
      <p class="scroll-reveal opacity-0 text-lg md:text-xl text-base-content/70 mb-4 max-w-xl mx-auto" style="animation-delay: 0.3s;">
        Developing the next generation of inline hockey players in Ballymena. 
        From first strides to competitive play.
      </p>

      <!-- Tagline -->
      <p class="scroll-reveal opacity-0 text-sm text-secondary/70 font-medium tracking-widest uppercase mb-8" style="animation-delay: 0.4s;">
        Junior U13 &bull; Learn to Play &bull; Learn to Skate
      </p>

      <!-- CTA Buttons -->
      <div class="scroll-reveal opacity-0 flex flex-col sm:flex-row gap-4 justify-center" style="animation-delay: 0.5s;">
        <a href="/contact" class="btn btn-secondary btn-lg font-semibold gap-2 shadow-lg shadow-secondary/25 hover:shadow-secondary/40 hover:scale-105 transition-all duration-300">
          Join Us Today
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a href="/fixtures" class="btn btn-outline btn-lg font-semibold gap-2 hover:scale-105 transition-all duration-300 border-base-content/20 hover:border-secondary hover:bg-secondary/10">
          View Fixtures
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </a>
      </div>

      <!-- Scroll indicator -->
      <div class="scroll-reveal opacity-0 mt-16" style="animation-delay: 0.7s;">
        <div class="flex flex-col items-center text-base-content/30">
          <span class="text-xs tracking-widest uppercase mb-2">Scroll</span>
          <div class="w-6 h-10 border-2 border-base-content/20 rounded-full flex justify-center">
            <div class="w-1.5 h-3 bg-secondary/60 rounded-full mt-2 animate-bounce"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════════════
     PROGRAMMES SECTION
     ═══════════════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-28 bg-base-200/50 relative">
  <!-- Section divider gradient -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-secondary/30 to-transparent"></div>

  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
    <!-- Section heading -->
    <div class="text-center mb-16">
      <span class="scroll-reveal opacity-0 badge badge-accent badge-outline badge-sm font-medium tracking-wider uppercase mb-4">Our Programmes</span>
      <h2 class="scroll-reveal opacity-0 font-heading text-3xl md:text-5xl font-bold mb-4">
        Find Your <span class="text-secondary">Level</span>
      </h2>
      <p class="scroll-reveal opacity-0 text-base-content/60 max-w-lg mx-auto">
        Whether you're lacing up for the first time or chasing silverware, we have a programme for you.
      </p>
    </div>

    <!-- Programme cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {% for program in programs %}
      <div class="scroll-reveal opacity-0 card bg-base-300/50 border border-base-300 hover:border-secondary/40 shadow-xl hover:shadow-secondary/10 transition-all duration-500 hover:-translate-y-2 group" style="animation-delay: {{ loop.index0 * 0.15 }}s;">
        <!-- Card image placeholder -->
        <figure class="bg-gradient-to-br from-secondary/10 via-accent/5 to-primary/10 flex items-center justify-center h-40 relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-secondary/20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          <p class="absolute bottom-2 text-[10px] text-base-content/20">Programme image</p>
        </figure>
        <div class="card-body items-center text-center">
          <!-- Icon -->
          <div class="text-5xl mb-4 group-hover:scale-110 transition-transform duration-300">
            {{ program.icon }}
          </div>
          <!-- Title -->
          <h3 class="card-title font-heading text-2xl text-secondary group-hover:text-accent transition-colors duration-300">
            {{ program.name }}
          </h3>
          <!-- Divider -->
          <div class="w-12 h-0.5 bg-secondary/30 group-hover:w-20 group-hover:bg-accent transition-all duration-500 my-2"></div>
          <!-- Description -->
          <p class="text-base-content/70 leading-relaxed">
            {{ program.description }}
          </p>
          <!-- CTA -->
          <div class="card-actions mt-4">
            <a href="/contact" class="btn btn-secondary btn-sm btn-outline gap-1 group-hover:btn-secondary group-hover:text-secondary-content transition-all duration-300">
              Learn More
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════════════
     STATS / HIGHLIGHTS BAR
     ═══════════════════════════════════════════════════════════════ -->
<section class="py-12 bg-gradient-to-r from-primary via-primary/90 to-primary relative overflow-hidden">
  <!-- Decorative -->
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 30px 30px;"></div>

  <div class="container mx-auto px-4 max-w-5xl relative z-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div class="scroll-reveal opacity-0">
        <div class="text-4xl md:text-5xl font-heading font-bold text-secondary counter" data-target="50">0</div>
        <div class="text-sm text-primary-content/70 mt-1 font-medium uppercase tracking-wider">Active Players</div>
      </div>
      <div class="scroll-reveal opacity-0" style="animation-delay: 0.1s;">
        <div class="text-4xl md:text-5xl font-heading font-bold text-accent counter" data-target="3">0</div>
        <div class="text-sm text-primary-content/70 mt-1 font-medium uppercase tracking-wider">Programmes</div>
      </div>
      <div class="scroll-reveal opacity-0" style="animation-delay: 0.2s;">
        <div class="text-4xl md:text-5xl font-heading font-bold text-secondary counter" data-target="8">0</div>
        <div class="text-sm text-primary-content/70 mt-1 font-medium uppercase tracking-wider">Coaches</div>
      </div>
      <div class="scroll-reveal opacity-0" style="animation-delay: 0.3s;">
        <div class="text-4xl md:text-5xl font-heading font-bold text-accent counter" data-target="2024">0</div>
        <div class="text-sm text-primary-content/70 mt-1 font-medium uppercase tracking-wider">Est.</div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════════════
     ABOUT US SECTION
     ═══════════════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-28 relative">
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Team photo placeholder -->
      <div class="scroll-reveal opacity-0">
        <div class="card bg-base-200 border border-base-300 shadow-xl overflow-hidden">
          <figure class="bg-gradient-to-br from-secondary/10 via-base-300/50 to-accent/10 flex items-center justify-center min-h-[320px] relative">
            <div class="text-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 text-secondary/20 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
              <p class="text-sm text-base-content/30 mt-3">Team photo placeholder</p>
            </div>
          </figure>
        </div>
      </div>

      <!-- About text -->
      <div class="scroll-reveal opacity-0" style="animation-delay: 0.15s;">
        <span class="badge badge-secondary badge-outline badge-sm font-medium tracking-wider uppercase mb-4">About Us</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold mb-6">
          Who Are <span class="text-secondary">Norstar</span>?
        </h2>
        <p class="text-base-content/70 leading-relaxed mb-4">
          Founded in 2024, Norstar Inline Hockey Club is Ballymena's first dedicated inline hockey club. 
          We're passionate about growing the sport in Northern Ireland and providing a welcoming environment 
          for players of all abilities.
        </p>
        <p class="text-base-content/70 leading-relaxed mb-6">
          From beginners taking their first strides to our competitive Junior U13 squad, we offer structured 
          programmes led by experienced coaches. Our home rink at Seven Towers Leisure Centre is where the 
          magic happens — every Saturday and Wednesday.
        </p>
        <div class="flex flex-wrap gap-3">
          <div class="flex items-center gap-2 text-sm text-base-content/60">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Qualified coaches
          </div>
          <div class="flex items-center gap-2 text-sm text-base-content/60">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            All ages welcome
          </div>
          <div class="flex items-center gap-2 text-sm text-base-content/60">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Equipment provided
          </div>
          <div class="flex items-center gap-2 text-sm text-base-content/60">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Family-friendly club
          </div>
        </div>
        <div class="mt-8">
          <a href="/contact" class="btn btn-secondary gap-2 hover:scale-105 transition-all duration-300 shadow-lg shadow-secondary/20">
            Learn More About Us
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════════════
     LATEST NEWS SECTION
     ═══════════════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-28 relative">
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
    <!-- Section heading -->
    <div class="text-center mb-16">
      <span class="scroll-reveal opacity-0 badge badge-secondary badge-outline badge-sm font-medium tracking-wider uppercase mb-4">Stay Updated</span>
      <h2 class="scroll-reveal opacity-0 font-heading text-3xl md:text-5xl font-bold mb-4">
        Latest <span class="text-secondary">News</span>
      </h2>
      <p class="scroll-reveal opacity-0 text-base-content/60 max-w-lg mx-auto">
        Keep up with everything happening at Norstar Inline Hockey.
      </p>
    </div>

    <!-- News cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {% for item in news %}
      <div class="scroll-reveal opacity-0 card bg-base-200 border border-base-300 hover:border-secondary/30 shadow-lg hover:shadow-secondary/10 transition-all duration-500 hover:-translate-y-1 group" style="animation-delay: {{ loop.index0 * 0.15 }}s;">
        <!-- News image placeholder -->
        <figure class="bg-gradient-to-br from-secondary/10 via-base-300 to-accent/10 flex items-center justify-center h-44 relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-secondary/20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          <p class="absolute bottom-2 text-[10px] text-base-content/20">News image</p>
        </figure>
        <div class="card-body">
          <!-- Date -->
          <div class="flex items-center gap-2 text-sm text-base-content/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {{ item.date }}
          </div>
          <!-- Title -->
          <h3 class="card-title font-heading text-xl group-hover:text-secondary transition-colors duration-300">
            {{ item.title }}
          </h3>
          <!-- Excerpt -->
          <p class="text-base-content/60 leading-relaxed text-sm">
            {{ item.excerpt }}
          </p>
          <!-- Read more -->
          <div class="card-actions mt-auto pt-4">
            <a href="/news" class="text-secondary text-sm font-semibold flex items-center gap-1 hover:gap-2 transition-all duration-300">
              Read More
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>

    <!-- View all news -->
    <div class="scroll-reveal opacity-0 text-center mt-12">
      <a href="/news" class="btn btn-outline btn-secondary btn-wide gap-2 hover:scale-105 transition-all duration-300">
        View All News
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════════════
     CALL TO ACTION SECTION
     ═══════════════════════════════════════════════════════════════ -->
<section class="py-20 lg:py-28 bg-base-200/50 relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>

  <!-- Decorative blobs -->
  <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-secondary/5 rounded-full blur-3xl"></div>
  <div class="absolute -top-20 -right-20 w-80 h-80 bg-accent/5 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-4 max-w-4xl relative z-10 text-center">
    <h2 class="scroll-reveal opacity-0 font-heading text-3xl md:text-5xl font-bold mb-6">
      Ready to Hit the <span class="text-accent">Rink</span>?
    </h2>
    <p class="scroll-reveal opacity-0 text-base-content/60 text-lg mb-10 max-w-2xl mx-auto">
      Whether you're a complete beginner or looking to join our competitive U13 squad, 
      we'd love to hear from you. Get in touch and start your inline hockey journey today.
    </p>
    <div class="scroll-reveal opacity-0 flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/contact" class="btn btn-accent btn-lg font-semibold gap-2 shadow-lg shadow-accent/25 hover:shadow-accent/40 hover:scale-105 transition-all duration-300">
        Get In Touch
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>
      <a href="https://shop.norstarinline.com" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg font-semibold gap-2 hover:scale-105 transition-all duration-300 border-base-content/20 hover:border-accent hover:bg-accent/10">
        Visit Shop
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</section>

{% endblock %}
