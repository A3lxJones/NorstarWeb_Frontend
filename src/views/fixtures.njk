{% extends "layouts/base.njk" %}

{% block content %}

<!-- Page Header -->
<section class="py-16 lg:py-20 bg-base-200/50 border-b border-base-300/50 relative overflow-hidden">
  <div class="absolute top-10 right-10 w-72 h-72 bg-secondary/5 rounded-full blur-3xl"></div>
  <div class="container mx-auto px-4 max-w-6xl text-center relative z-10">
    <span class="scroll-reveal opacity-0 badge badge-secondary badge-outline badge-sm font-medium tracking-wider uppercase mb-4">Season Schedule</span>
    <h1 class="scroll-reveal opacity-0 font-heading text-4xl md:text-6xl font-bold mb-4">
      Fixtures & <span class="text-secondary">Calendar</span>
    </h1>
    <p class="scroll-reveal opacity-0 text-base-content/60 max-w-lg mx-auto">
      Stay on top of all upcoming matches, training sessions, and club events.
    </p>
  </div>
</section>

<!-- Filter Tabs -->
<section class="py-8 bg-base-100 border-b border-base-300/30 sticky top-[64px] z-30 backdrop-blur-md">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="flex flex-wrap gap-2 justify-center">
      <button class="btn btn-sm btn-secondary font-medium">All</button>
      <button class="btn btn-sm btn-ghost border-base-300 font-medium hover:btn-secondary">U13 League</button>
      <button class="btn btn-sm btn-ghost border-base-300 font-medium hover:btn-secondary">Learn to Play</button>
      <button class="btn btn-sm btn-ghost border-base-300 font-medium hover:btn-secondary">Learn to Skate</button>
      <button class="btn btn-sm btn-ghost border-base-300 font-medium hover:btn-secondary">Training</button>
      <button class="btn btn-sm btn-ghost border-base-300 font-medium hover:btn-secondary">Events</button>
    </div>
  </div>
</section>

<!-- Calendar Widget Placeholder -->
<section class="py-16 lg:py-20">
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">

    <!-- Month navigation placeholder -->
    <div class="scroll-reveal opacity-0 flex items-center justify-between mb-8">
      <button class="btn btn-ghost btn-sm gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        Previous
      </button>
      <h2 class="font-heading text-2xl md:text-3xl font-bold">
        February <span class="text-secondary">2026</span>
      </h2>
      <button class="btn btn-ghost btn-sm gap-1">
        Next
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>

    <!-- Calendar grid placeholder -->
    <div class="scroll-reveal opacity-0 card bg-base-200 border border-base-300 shadow-xl overflow-hidden">
      <!-- Day headers -->
      <div class="grid grid-cols-7 bg-base-300/50 border-b border-base-300">
        {% for day in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] %}
        <div class="py-3 text-center text-xs font-bold uppercase tracking-wider text-base-content/50">{{ day }}</div>
        {% endfor %}
      </div>
      <!-- Week rows (placeholder) -->
      {% for week in range(0, 5) %}
      <div class="grid grid-cols-7 border-b border-base-300/30 last:border-0">
        {% for day in range(0, 7) %}
        {% set cellDay = week * 7 + day - 1 %}
        <div class="min-h-[80px] md:min-h-[100px] p-1.5 border-r border-base-300/20 last:border-0 hover:bg-base-300/30 transition-colors cursor-pointer group relative">
          {% if cellDay >= 1 and cellDay <= 28 %}
          <span class="text-xs font-medium text-base-content/40 group-hover:text-secondary transition-colors">{{ cellDay }}</span>
          {% if cellDay == 15 %}
          <div class="mt-1 px-1.5 py-0.5 bg-secondary/20 text-secondary text-[10px] font-medium rounded truncate">U13 Match</div>
          {% endif %}
          {% if cellDay == 18 %}
          <div class="mt-1 px-1.5 py-0.5 bg-accent/20 text-accent text-[10px] font-medium rounded truncate">Learn to Skate</div>
          {% endif %}
          {% if cellDay == 22 %}
          <div class="mt-1 px-1.5 py-0.5 bg-secondary/20 text-secondary text-[10px] font-medium rounded truncate">U13 Away</div>
          {% endif %}
          {% if cellDay == 12 or cellDay == 19 or cellDay == 26 %}
          <div class="mt-1 px-1.5 py-0.5 bg-info/20 text-info text-[10px] font-medium rounded truncate">Training</div>
          {% endif %}
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endfor %}
      <!-- Legend -->
      <div class="p-4 bg-base-300/30 flex flex-wrap gap-4 text-xs">
        <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-secondary/30"></span> Matches</div>
        <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-accent/30"></span> Learn to Skate</div>
        <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-info/30"></span> Training</div>
        <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-success/30"></span> Events</div>
        <span class="ml-auto badge badge-ghost badge-xs">Interactive calendar coming with API</span>
      </div>
    </div>

  </div>
</section>

<!-- Upcoming Fixtures List -->
<section class="py-16 lg:py-20 bg-base-200/50">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-secondary/30 to-transparent"></div>
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
    <div class="flex items-end justify-between mb-10">
      <div>
        <span class="scroll-reveal opacity-0 badge badge-accent badge-outline badge-sm font-medium tracking-wider uppercase mb-3">Coming Up</span>
        <h2 class="scroll-reveal opacity-0 font-heading text-2xl md:text-4xl font-bold">
          Upcoming <span class="text-secondary">Fixtures</span>
        </h2>
      </div>
      <div class="scroll-reveal opacity-0 hidden md:block">
        <div class="flex gap-2">
          <button class="btn btn-sm btn-ghost border-base-300">List View</button>
          <button class="btn btn-sm btn-ghost border-base-300">Card View</button>
        </div>
      </div>
    </div>

    <div class="space-y-4">
      <!-- Fixture 1 -->
      <div class="scroll-reveal opacity-0 card card-side bg-base-100 border border-base-300 shadow-md hover:border-secondary/30 transition-all duration-300 hover:shadow-lg">
        <div class="bg-secondary/10 flex flex-col items-center justify-center px-6 py-4 min-w-[100px]">
          <span class="font-heading text-3xl font-bold text-secondary">15</span>
          <span class="text-xs uppercase tracking-wider text-base-content/60">Feb</span>
          <span class="text-[10px] text-base-content/40">SAT</span>
        </div>
        <div class="card-body py-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <h3 class="card-title text-lg font-heading">Norstar U13 vs Belfast Blades</h3>
              <p class="text-sm text-base-content/60">Seven Towers Leisure Centre, Ballymena &bull; 14:00</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="badge badge-secondary badge-sm">U13 League</span>
              <span class="badge badge-outline badge-sm text-success border-success/30">Home</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Fixture 2 -->
      <div class="scroll-reveal opacity-0 card card-side bg-base-100 border border-base-300 shadow-md hover:border-accent/30 transition-all duration-300 hover:shadow-lg" style="animation-delay: 0.1s;">
        <div class="bg-accent/10 flex flex-col items-center justify-center px-6 py-4 min-w-[100px]">
          <span class="font-heading text-3xl font-bold text-accent">18</span>
          <span class="text-xs uppercase tracking-wider text-base-content/60">Feb</span>
          <span class="text-[10px] text-base-content/40">TUE</span>
        </div>
        <div class="card-body py-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <h3 class="card-title text-lg font-heading">Learn to Skate — Open Session</h3>
              <p class="text-sm text-base-content/60">Seven Towers Leisure Centre, Ballymena &bull; 10:00</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="badge badge-accent badge-sm">Learn to Skate</span>
              <span class="badge badge-outline badge-sm text-info border-info/30">Open</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Fixture 3 -->
      <div class="scroll-reveal opacity-0 card card-side bg-base-100 border border-base-300 shadow-md hover:border-secondary/30 transition-all duration-300 hover:shadow-lg" style="animation-delay: 0.2s;">
        <div class="bg-secondary/10 flex flex-col items-center justify-center px-6 py-4 min-w-[100px]">
          <span class="font-heading text-3xl font-bold text-secondary">22</span>
          <span class="text-xs uppercase tracking-wider text-base-content/60">Feb</span>
          <span class="text-[10px] text-base-content/40">SAT</span>
        </div>
        <div class="card-body py-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <h3 class="card-title text-lg font-heading">Norstar U13 vs Lisburn Lightning</h3>
              <p class="text-sm text-base-content/60">Lagan Valley LeisurePlex, Lisburn &bull; 15:00</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="badge badge-secondary badge-sm">U13 League</span>
              <span class="badge badge-outline badge-sm text-warning border-warning/30">Away</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Fixture 4 -->
      <div class="scroll-reveal opacity-0 card card-side bg-base-100 border border-base-300 shadow-md hover:border-secondary/30 transition-all duration-300 hover:shadow-lg" style="animation-delay: 0.3s;">
        <div class="bg-info/10 flex flex-col items-center justify-center px-6 py-4 min-w-[100px]">
          <span class="font-heading text-3xl font-bold text-info">26</span>
          <span class="text-xs uppercase tracking-wider text-base-content/60">Feb</span>
          <span class="text-[10px] text-base-content/40">WED</span>
        </div>
        <div class="card-body py-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <h3 class="card-title text-lg font-heading">Training Session — All Squads</h3>
              <p class="text-sm text-base-content/60">Seven Towers Leisure Centre, Ballymena &bull; 18:00 – 19:30</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="badge badge-info badge-sm">Training</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Load more -->
    <div class="scroll-reveal opacity-0 text-center mt-10">
      <button class="btn btn-outline btn-secondary btn-wide gap-2 hover:scale-105 transition-all duration-300" disabled>
        Load More Fixtures
        <span class="badge badge-xs badge-ghost">API Coming Soon</span>
      </button>
    </div>

  </div>
</section>

<!-- League Table Placeholder -->
<section class="py-16 lg:py-20">
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
    <div class="text-center mb-10">
      <span class="scroll-reveal opacity-0 badge badge-secondary badge-outline badge-sm font-medium tracking-wider uppercase mb-3">Standings</span>
      <h2 class="scroll-reveal opacity-0 font-heading text-2xl md:text-4xl font-bold">
        League <span class="text-secondary">Table</span>
      </h2>
    </div>

    <div class="scroll-reveal opacity-0 overflow-x-auto">
      <table class="table table-zebra bg-base-200 border border-base-300 rounded-xl overflow-hidden">
        <thead>
          <tr class="bg-base-300/50 text-base-content/70">
            <th class="text-center">#</th>
            <th>Team</th>
            <th class="text-center">P</th>
            <th class="text-center">W</th>
            <th class="text-center">D</th>
            <th class="text-center">L</th>
            <th class="text-center">GF</th>
            <th class="text-center">GA</th>
            <th class="text-center">GD</th>
            <th class="text-center font-bold text-secondary">Pts</th>
          </tr>
        </thead>
        <tbody>
          <tr class="bg-secondary/5 border-l-2 border-l-secondary">
            <td class="text-center font-bold">1</td>
            <td class="font-heading font-bold text-secondary">Norstar U13</td>
            <td class="text-center">6</td>
            <td class="text-center">5</td>
            <td class="text-center">1</td>
            <td class="text-center">0</td>
            <td class="text-center">28</td>
            <td class="text-center">8</td>
            <td class="text-center text-success">+20</td>
            <td class="text-center font-bold text-secondary">16</td>
          </tr>
          <tr>
            <td class="text-center font-bold">2</td>
            <td class="font-heading font-medium">Belfast Blades</td>
            <td class="text-center">6</td>
            <td class="text-center">4</td>
            <td class="text-center">1</td>
            <td class="text-center">1</td>
            <td class="text-center">22</td>
            <td class="text-center">12</td>
            <td class="text-center text-success">+10</td>
            <td class="text-center font-bold">13</td>
          </tr>
          <tr>
            <td class="text-center font-bold">3</td>
            <td class="font-heading font-medium">Lisburn Lightning</td>
            <td class="text-center">6</td>
            <td class="text-center">3</td>
            <td class="text-center">0</td>
            <td class="text-center">3</td>
            <td class="text-center">18</td>
            <td class="text-center">16</td>
            <td class="text-center text-success">+2</td>
            <td class="text-center font-bold">9</td>
          </tr>
          <tr>
            <td class="text-center font-bold">4</td>
            <td class="font-heading font-medium">Derry Destroyers</td>
            <td class="text-center">6</td>
            <td class="text-center">2</td>
            <td class="text-center">1</td>
            <td class="text-center">3</td>
            <td class="text-center">14</td>
            <td class="text-center">20</td>
            <td class="text-center text-error">-6</td>
            <td class="text-center font-bold">7</td>
          </tr>
          <tr>
            <td class="text-center font-bold">5</td>
            <td class="font-heading font-medium">Craigavon Coyotes</td>
            <td class="text-center">6</td>
            <td class="text-center">0</td>
            <td class="text-center">1</td>
            <td class="text-center">5</td>
            <td class="text-center">6</td>
            <td class="text-center">32</td>
            <td class="text-center text-error">-26</td>
            <td class="text-center font-bold">1</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-base-content/40 text-center mt-4">Placeholder data — league table will be populated from the backend API.</p>

  </div>
</section>

{% endblock %}
