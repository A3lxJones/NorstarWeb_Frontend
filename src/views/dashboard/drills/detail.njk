{% extends "layouts/base.njk" %}

{% block content %}
{% include "partials/impersonation-banner.njk" %}

<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-4xl">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 mb-6 text-sm text-base-content/50">
      <a href="/dashboard" class="hover:text-secondary transition-colors">Dashboard</a>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href="/dashboard/drills" class="hover:text-secondary transition-colors">Drill Library</a>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-base-content/70">{{ drill.name }}</span>
    </div>

    <!-- Header Card -->
    <div class="card bg-base-200 border border-base-300 shadow-xl mb-8 overflow-hidden">
      <!-- Gradient top bar -->
      <div class="h-1.5 bg-gradient-to-r from-secondary via-primary to-accent"></div>
      <div class="card-body p-6 md:p-8">

        <!-- Badges row -->
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="badge
            {% if drill.difficulty === 'Beginner' %}badge-success
            {% elif drill.difficulty === 'Intermediate' %}badge-warning
            {% elif drill.difficulty === 'Advanced' %}badge-error
            {% else %}badge-info{% endif %}
            gap-1">
            {% if drill.difficulty === 'Beginner' %}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            {% elif drill.difficulty === 'Intermediate' %}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
            {% elif drill.difficulty === 'Advanced' %}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" /></svg>
            {% endif %}
            {{ drill.difficulty }}
          </span>
          <span class="badge badge-secondary badge-outline">{{ drill.category }}</span>
          {% if drill.suitable_for %}
          {% for age in drill.suitable_for %}
          <span class="badge badge-ghost badge-sm">{{ age }}</span>
          {% endfor %}
          {% endif %}
        </div>

        <!-- Title -->
        <h1 class="font-heading text-3xl md:text-4xl font-bold mb-3">
          {{ drill.name }}<span class="text-secondary">.</span>
        </h1>

        <!-- Description -->
        <p class="text-base-content/70 text-lg leading-relaxed">
          {{ drill.description }}
        </p>

        <!-- Quick stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-6 border-t border-base-300">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-base-content/40 uppercase tracking-wider">Duration</p>
              <p class="font-semibold">{{ drill.duration_minutes }} min</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-base-content/40 uppercase tracking-wider">Players</p>
              <p class="font-semibold">{{ drill.min_players }}–{{ drill.max_players }}</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-base-content/40 uppercase tracking-wider">Level</p>
              <p class="font-semibold">{{ drill.difficulty }}</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-base-content/40 uppercase tracking-wider">Category</p>
              <p class="font-semibold">{{ drill.category }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Content Grid -->
    <div class="grid gap-6 lg:grid-cols-3">

      <!-- Main content (2 cols) -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Objectives -->
        {% if drill.objectives and drill.objectives.length > 0 %}
        <div class="card bg-base-200 border border-base-300 shadow-lg scroll-reveal opacity-0">
          <div class="card-body p-6">
            <h2 class="font-heading text-xl font-semibold flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
              Objectives
            </h2>
            <ul class="space-y-2">
              {% for obj in drill.objectives %}
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-base-content/80">{{ obj }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        {% endif %}

        <!-- Setup -->
        {% if drill.setup %}
        <div class="card bg-base-200 border border-base-300 shadow-lg scroll-reveal opacity-0">
          <div class="card-body p-6">
            <h2 class="font-heading text-xl font-semibold flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Setup
            </h2>
            <p class="text-base-content/80 leading-relaxed">{{ drill.setup }}</p>
          </div>
        </div>
        {% endif %}

        <!-- Step-by-step Instructions -->
        {% if drill.instructions and drill.instructions.length > 0 %}
        <div class="card bg-base-200 border border-base-300 shadow-lg scroll-reveal opacity-0">
          <div class="card-body p-6">
            <h2 class="font-heading text-xl font-semibold flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
              Instructions
            </h2>
            <ol class="space-y-4">
              {% for step in drill.instructions %}
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-secondary/20 text-secondary flex items-center justify-center font-heading font-bold text-sm">
                  {{ loop.index }}
                </div>
                <p class="text-base-content/80 leading-relaxed pt-1">{{ step }}</p>
              </li>
              {% endfor %}
            </ol>
          </div>
        </div>
        {% endif %}

        <!-- Coaching Points -->
        {% if drill.coaching_points and drill.coaching_points.length > 0 %}
        <div class="card bg-base-200 border border-base-300 shadow-lg scroll-reveal opacity-0">
          <div class="card-body p-6">
            <h2 class="font-heading text-xl font-semibold flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              Coaching Points
            </h2>
            <ul class="space-y-3">
              {% for point in drill.coaching_points %}
              <li class="flex items-start gap-3 p-3 rounded-lg bg-accent/5 border border-accent/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-base-content/80">{{ point }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        {% endif %}

        <!-- Variations -->
        {% if drill.variations and drill.variations.length > 0 %}
        <div class="card bg-base-200 border border-base-300 shadow-lg scroll-reveal opacity-0">
          <div class="card-body p-6">
            <h2 class="font-heading text-xl font-semibold flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              Variations
            </h2>
            <ul class="space-y-2">
              {% for variation in drill.variations %}
              <li class="flex items-start gap-2">
                <span class="text-secondary font-bold mt-0.5">→</span>
                <span class="text-base-content/80">{{ variation }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        {% endif %}

      </div>

      <!-- Sidebar (1 col) -->
      <div class="space-y-6">

        <!-- Equipment needed -->
        {% if drill.equipment and drill.equipment.length > 0 %}
        <div class="card bg-base-200 border border-base-300 shadow-lg scroll-reveal opacity-0">
          <div class="card-body p-6">
            <h2 class="font-heading text-lg font-semibold flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
              Equipment
            </h2>
            <ul class="space-y-2">
              {% for item in drill.equipment %}
              <li class="flex items-center gap-2 text-base-content/70">
                <span class="w-2 h-2 bg-secondary rounded-full shrink-0"></span>
                {{ item }}
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        {% endif %}

        <!-- Quick Reference Card -->
        <div class="card bg-gradient-to-br from-secondary/10 to-accent/5 border border-secondary/20 shadow-lg scroll-reveal opacity-0">
          <div class="card-body p-6">
            <h2 class="font-heading text-lg font-semibold mb-4">Quick Reference</h2>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between">
                <span class="text-base-content/50">Duration</span>
                <span class="font-medium">{{ drill.duration_minutes }} minutes</span>
              </div>
              <div class="divider my-0"></div>
              <div class="flex justify-between">
                <span class="text-base-content/50">Players</span>
                <span class="font-medium">{{ drill.min_players }}–{{ drill.max_players }}</span>
              </div>
              <div class="divider my-0"></div>
              <div class="flex justify-between">
                <span class="text-base-content/50">Difficulty</span>
                <span class="font-medium">{{ drill.difficulty }}</span>
              </div>
              <div class="divider my-0"></div>
              <div class="flex justify-between">
                <span class="text-base-content/50">Category</span>
                <span class="font-medium">{{ drill.category }}</span>
              </div>
              {% if drill.equipment %}
              <div class="divider my-0"></div>
              <div class="flex justify-between">
                <span class="text-base-content/50">Equipment</span>
                <span class="font-medium">{{ drill.equipment | length }} items</span>
              </div>
              {% endif %}
            </div>
          </div>
        </div>

        <!-- Back to Library -->
        <a href="/dashboard/drills" class="btn btn-outline btn-secondary btn-block gap-2 hover:scale-[1.02] transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          Back to Drill Library
        </a>

      </div>

    </div>

  </div>
</section>
{% endblock %}
