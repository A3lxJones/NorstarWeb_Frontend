{% extends "layouts/base.njk" %}

{% block content %}
  <!-- ======== HERO SECTION ======== -->
  <section class="min-h-[70vh] flex items-center justify-center py-16 md:py-24 bg-base-200/40">
    <div class="relative z-10 max-w-2xl mx-auto px-4 text-center">
      <!-- Icon -->
      <div class="mb-8 flex justify-center">
        <div class="p-6 bg-secondary/10 text-secondary rounded-full border border-secondary/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
      </div>

      <span class="eyebrow mb-3 block">Shop</span>

      <!-- Heading -->
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4 leading-tight">
        Coming soon
      </h1>

      <!-- Subheading -->
      <p class="text-lg text-base-content/70 mb-8 leading-relaxed">
        Our Norstar Inline Hockey Shop is launching soon. Gear up with exclusive team merchandise, equipment, and apparel.
      </p>

      <!-- Description -->
      <div class="bg-base-100 border border-base-300 rounded-box p-6 mb-8">
        <p class="text-base-content/65">
          We're working on a quality selection of products. Check back soon for announcements.
        </p>
      </div>

      <!-- CTA Button -->
      <a href="/" class="btn btn-secondary gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to home
      </a>
    </div>
  </section>
{% endblock %}
