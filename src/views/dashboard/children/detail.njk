{% extends "layouts/base.njk" %}

{% block content %}
{% include "partials/impersonation-banner.njk" %}

<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-2xl">

    <!-- Back link -->
    <a href="/dashboard" class="btn btn-ghost btn-sm gap-1 mb-6 -ml-2 text-base-content/60 hover:text-secondary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Dashboard
    </a>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="font-heading text-3xl font-bold">
          {{ child.first_name }} {{ child.last_name }}<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/60 mt-1">Child profile details</p>
      </div>
      <div class="flex gap-2">
        <a href="/dashboard/children/{{ child.id }}/edit" class="btn btn-secondary btn-sm gap-1 hover:scale-[1.02] transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit
        </a>
      </div>
    </div>

    <!-- Profile Card -->
    <div class="card bg-base-200 border border-base-300 shadow-xl">
      <div class="card-body">

        <!-- Personal Details -->
        <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Personal Details
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-base-content/50 text-xs uppercase tracking-wide">Full Name</span>
            <p class="font-medium mt-0.5">{{ child.first_name }} {{ child.last_name }}</p>
          </div>
          <div>
            <span class="text-base-content/50 text-xs uppercase tracking-wide">Date of Birth</span>
            <p class="font-medium mt-0.5">{{ child.date_of_birth }}</p>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Hockey Details -->
        <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Hockey Details
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-base-content/50 text-xs uppercase tracking-wide">Skill Level</span>
            <p class="font-medium mt-0.5">
              {% if child.skill_level %}
                <span class="badge badge-sm badge-outline badge-secondary">{{ child.skill_level | capitalize }}</span>
              {% else %}
                <span class="text-base-content/40">Not set</span>
              {% endif %}
            </p>
          </div>
          <div>
            <span class="text-base-content/50 text-xs uppercase tracking-wide">Position</span>
            <p class="font-medium mt-0.5">
              {% if child.position %}
                {{ child.position | capitalize }}
              {% else %}
                <span class="text-base-content/40">Not set</span>
              {% endif %}
            </p>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Emergency Contact -->
        <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Emergency Contact
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-base-content/50 text-xs uppercase tracking-wide">Contact Name</span>
            <p class="font-medium mt-0.5">{{ child.emergency_contact_name or '—' }}</p>
          </div>
          <div>
            <span class="text-base-content/50 text-xs uppercase tracking-wide">Contact Phone</span>
            <p class="font-medium mt-0.5">{{ child.emergency_contact_phone or '—' }}</p>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Medical -->
        <h2 class="font-heading text-lg font-semibold mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Medical Information
        </h2>

        <div class="space-y-3 text-sm">
          <div>
            <span class="text-base-content/50 text-xs uppercase tracking-wide">Medical Conditions</span>
            <p class="font-medium mt-0.5">
              {% if child.medical_conditions %}
                {{ child.medical_conditions }}
              {% else %}
                <span class="text-base-content/40">None reported</span>
              {% endif %}
            </p>
          </div>
          <div>
            <span class="text-base-content/50 text-xs uppercase tracking-wide">Allergies</span>
            <p class="font-medium mt-0.5">
              {% if child.allergies %}
                {{ child.allergies }}
              {% else %}
                <span class="text-base-content/40">None reported</span>
              {% endif %}
            </p>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Consent -->
        <div class="flex items-center gap-3 text-sm">
          <span class="text-base-content/50 text-xs uppercase tracking-wide">Photo Consent</span>
          {% if child.photo_consent %}
            <span class="badge badge-success badge-sm gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Granted
            </span>
          {% else %}
            <span class="badge badge-warning badge-sm gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              Not granted
            </span>
          {% endif %}
        </div>

      </div>
    </div>

    <!-- Danger Zone -->
    <div class="card bg-base-200 border border-error/30 shadow-lg mt-6">
      <div class="card-body">
        <h2 class="font-heading text-lg font-semibold text-error mb-2">Danger Zone</h2>
        <p class="text-sm text-base-content/60 mb-4">Removing a child will also remove their team registrations and availability records.</p>
        <form action="/dashboard/children/{{ child.id }}/delete" method="POST" class="inline">
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" />
          <button type="submit" class="btn btn-error btn-sm btn-outline gap-1 hover:scale-[1.02] transition-all"
                  onclick="return confirm('Are you sure you want to remove {{ child.first_name }}? This cannot be undone.')">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Remove Child
          </button>
        </form>
      </div>
    </div>

  </div>
</section>
{% endblock %}
