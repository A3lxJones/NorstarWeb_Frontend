{% extends "layouts/base.njk" %}

{% block content %}

<section class="min-h-[80vh] flex items-center justify-center bg-base-200/40 py-12">

  <div class="relative z-10 w-full max-w-md mx-auto px-4">
    <div class="scroll-reveal opacity-0 bg-base-100 border border-base-300 rounded-box">
      <div class="p-8">
        <!-- Header -->
        <div class="text-center mb-6">
          <h1 class="font-heading text-3xl font-bold mb-2">
            <span class="text-secondary">NOR</span>STAR
          </h1>
          <p class="text-base-content/60 text-sm">Set a new password</p>
        </div>

        {% if success %}
        <div class="alert alert-success text-sm mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{{ success }}</span>
        </div>
        <a href="/login" class="btn btn-secondary btn-block font-semibold gap-2">
          Go to Sign In
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
          </svg>
        </a>
        {% else %}

        {% if error %}
        <div class="alert alert-error text-sm mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{{ error }}</span>
        </div>
        {% endif %}

        <!-- No-token warning (shown/hidden by JS) -->
        <div id="reset-no-token" class="alert alert-warning text-sm mb-4 hidden">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
          <span>Invalid or missing reset link. Please <a href="/forgot-password" class="link link-hover text-warning-content font-semibold">request a new one</a>.</span>
        </div>

        <form id="reset-password-form" action="/reset-password" method="POST" class="space-y-5 hidden" novalidate>
          <!-- Token from URL hash — populated by JS -->
          <input type="hidden" id="reset-access-token" name="access_token" value="" />

          <!-- New Password -->
          <div class="form-control">
            <label class="label" for="reset-password">
              <span class="label-text font-medium">New Password <span class="text-error">*</span></span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-base-content/40">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </span>
              <input type="password" id="reset-password" name="password" placeholder="Min. 8 characters"
                     class="input input-bordered w-full pl-10 focus:input-secondary transition-colors"
                     required autocomplete="new-password" minlength="8" />
            </div>
          </div>

          <!-- Confirm Password -->
          <div class="form-control">
            <label class="label" for="reset-confirm">
              <span class="label-text font-medium">Confirm Password <span class="text-error">*</span></span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-base-content/40">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </span>
              <input type="password" id="reset-confirm" name="confirm_password" placeholder="Re-enter password"
                     class="input input-bordered w-full pl-10 focus:input-secondary transition-colors"
                     required autocomplete="new-password" minlength="8" />
            </div>
          </div>

          <!-- Honeypot (anti-bot) -->
          <div class="hidden" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="btn btn-secondary btn-block font-semibold gap-2">
            Reset Password
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </button>
        </form>
        {% endif %}
      </div>
    </div>

    <!-- Security note -->
    <div class="scroll-reveal opacity-0 text-center mt-6" style="animation-delay: 0.2s;">
      <p class="text-xs text-base-content/40 flex items-center justify-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        Secured with bcrypt hashing, rate limiting &amp; HTTPS
      </p>
    </div>
  </div>
</section>

{% endblock %}

{% block scripts %}
<script nonce="{{ cspNonce }}">
  (function () {
    // Token may come from a server-side PKCE exchange (rendered into the page)
    // or from the URL hash fragment (implicit flow).
    var serverToken = {{ serverToken | dump | safe if serverToken else 'null' }};

    var token = serverToken;
    if (!token) {
      var hash = window.location.hash;
      var params = new URLSearchParams(hash.replace('#', '?'));
      token = params.get('access_token');
    }

    var form = document.getElementById('reset-password-form');
    var warning = document.getElementById('reset-no-token');
    var tokenInput = document.getElementById('reset-access-token');

    if (token && form && tokenInput) {
      tokenInput.value = token;
      form.classList.remove('hidden');
    } else if (warning) {
      warning.classList.remove('hidden');
    }

    // Clear the hash from the URL so the token is not leaked in history/referrer
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', window.location.pathname);
    }
  })();
</script>
{% endblock %}
