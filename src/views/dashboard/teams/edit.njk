{% extends "layouts/base.njk" %}

{% block content %}
<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-lg">

    <!-- Breadcrumb -->
    <div class="text-sm breadcrumbs mb-6">
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/dashboard/teams">Teams</a></li>
        <li class="text-base-content/60">Edit</li>
      </ul>
    </div>

    <div class="card bg-base-200 border border-base-300 shadow-2xl">
      <div class="card-body p-8">
        <h1 class="font-heading text-2xl font-bold mb-1">
          Edit Team<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/60 text-sm mb-6">Update team details</p>

        {% if error %}
        <div class="alert alert-error text-sm mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{{ error }}</span>
        </div>
        {% endif %}

        <form action="/dashboard/teams/{{ teamId }}/edit" method="POST" class="space-y-5" novalidate>

          <!-- Team Name -->
          <div class="form-control">
            <label class="label" for="team-name">
              <span class="label-text font-medium">Team Name <span class="text-error">*</span></span>
            </label>
            <input type="text" id="team-name" name="name"
                   value="{{ values.name or '' }}"
                   placeholder="e.g. Norstar U14 Academy"
                   class="input input-bordered w-full focus:input-secondary transition-colors"
                   required maxlength="100" />
          </div>

          <!-- Age Group -->
          <div class="form-control">
            <label class="label" for="team-age-group">
              <span class="label-text font-medium">Age Group <span class="text-error">*</span></span>
            </label>
            <select id="team-age-group" name="age_group" class="select select-bordered w-full focus:select-secondary transition-colors" required>
              <option value="" disabled>Select age group</option>
              <option value="learn_to_skate" {% if values.age_group === 'learn_to_skate' %}selected{% endif %}>Learn to Skate</option>
              <option value="u12" {% if values.age_group === 'u12' %}selected{% endif %}>Under 12</option>
              <option value="u14" {% if values.age_group === 'u14' %}selected{% endif %}>Under 14</option>
            </select>
          </div>

          <!-- Coach Assignment (Admin Only) -->
          {% if isAdmin %}
          <div class="form-control">
            <label class="label" for="team-coach">
              <span class="label-text font-medium">Assign Coach</span>
            </label>
            <select id="team-coach" name="coach_id" class="select select-bordered w-full focus:select-secondary transition-colors">
              <option value="">Unassigned</option>
              {% if availableCoaches %}
                {% for coach in availableCoaches %}
                  <option value="{{ coach.id }}" {% if values.coach_id === coach.id %}selected{% endif %}>
                    {{ coach.full_name }} {% if coach.team_id and coach.team_id !== values.id %}<span class="text-accent text-xs">(currently assigned)</span>{% endif %}
                  </option>
                {% endfor %}
              {% endif %}
            </select>
          </div>
          {% endif %}

          <!-- Actions -->
          <div class="flex gap-3 pt-2">
            <a href="/dashboard/teams/{{ teamId }}" class="btn btn-ghost flex-1">Cancel</a>
            <button type="submit" class="btn btn-secondary flex-1 gap-2 font-semibold">
              Save Changes
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</section>
{% endblock %}
