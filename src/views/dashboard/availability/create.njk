{% extends "layouts/base.njk" %}

{% block content %}
<section class="min-h-[80vh] py-12">
  <div class="container mx-auto px-4 max-w-lg">

    <!-- Breadcrumb -->
    <div class="text-sm breadcrumbs mb-6">
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/dashboard/availability">Availability</a></li>
        <li class="text-base-content/60">Create</li>
      </ul>
    </div>

    <div class="card bg-base-200 border border-base-300 shadow-2xl">
      <div class="card-body p-8">
        <h1 class="font-heading text-2xl font-bold mb-1">
          New Availability Request<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/60 text-sm mb-6">Ask parents if their child can make it</p>

        {% if error %}
        <div class="alert alert-error text-sm mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{{ error }}</span>
        </div>
        {% endif %}

        <form action="/dashboard/availability/create" method="POST" class="space-y-5" novalidate>
          <!-- Honeypot -->
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" />

          <!-- Title -->
          <div class="form-control">
            <label class="label" for="req-title">
              <span class="label-text font-medium">Title <span class="text-error">*</span></span>
            </label>
            <input type="text" id="req-title" name="title"
                   value="{{ values.title or '' }}"
                   placeholder="e.g. Saturday Match vs Belfast Blades"
                   class="input input-bordered w-full focus:input-secondary transition-colors"
                   required maxlength="200" autocomplete="off" />
          </div>

          <!-- Team -->
          <div class="form-control">
            <label class="label" for="req-team">
              <span class="label-text font-medium">Team <span class="text-error">*</span></span>
            </label>
            {% if teams.length === 0 %}
            <div class="alert alert-warning text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>No teams found. <a href="/dashboard/teams/create" class="link link-secondary">Create a team</a> first.</span>
            </div>
            {% else %}
            <select id="req-team" name="team_id" class="select select-bordered w-full focus:select-secondary transition-colors" required>
              <option value="" disabled {% if not values.team_id %}selected{% endif %}>Select a team</option>
              {% for team in teams %}
              <option value="{{ team.id }}" {% if values.team_id == team.id %}selected{% endif %}>
                {{ team.name }} ({{ team.age_group }})
              </option>
              {% endfor %}
            </select>
            {% endif %}
          </div>

          <!-- Request Type -->
          <div class="form-control">
            <label class="label" for="req-request-type">
              <span class="label-text font-medium">Request Type <span class="text-error">*</span></span>
            </label>
            <select id="req-request-type" name="request_type" class="select select-bordered w-full focus:select-secondary transition-colors" required>
              <option value="" disabled {% if not values.request_type %}selected{% endif %}>Select request type</option>
              <option value="training" {% if values.request_type == 'training' %}selected{% endif %}>Training</option>
              <option value="match" {% if values.request_type == 'match' %}selected{% endif %}>Match</option>
              <option value="other" {% if values.request_type == 'other' %}selected{% endif %}>Other</option>
            </select>
          </div>

          <!-- Custom Request Type (shown when "Other" selected) -->
          <div class="form-control" id="custom-request-type-group" style="display: none;">
            <label class="label" for="req-custom-request-type">
              <span class="label-text font-medium">Specify Request Type <span class="text-error">*</span></span>
            </label>
            <input type="text" id="req-custom-request-type" name="custom_request_type"
                   value="{{ values.custom_request_type or '' }}"
                   placeholder="e.g. Tournament, Friendly, Awards Night"
                   class="input input-bordered w-full focus:input-secondary transition-colors"
                   maxlength="100" autocomplete="off" />
          </div>

          <!-- Event Date -->
          <div class="form-control">
            <label class="label" for="req-event-date">
              <span class="label-text font-medium">Event Date <span class="text-error">*</span></span>
            </label>
            <input type="date" id="req-event-date" name="event_date"
                   value="{{ values.event_date or '' }}"
                   class="input input-bordered w-full focus:input-secondary transition-colors"
                   required />
          </div>

          <!-- Response Deadline (optional) -->
          <div class="form-control">
            <label class="label" for="req-deadline">
              <span class="label-text font-medium">Response Deadline <span class="text-base-content/40">(optional)</span></span>
            </label>
            <input type="date" id="req-deadline" name="deadline"
                   value="{{ values.deadline or '' }}"
                   class="input input-bordered w-full focus:input-secondary transition-colors" />
            <label class="label">
              <span class="label-text-alt text-base-content/40">Parents will be encouraged to respond before this date</span>
            </label>
          </div>

          <!-- Notes (optional) -->
          <div class="form-control">
            <label class="label" for="req-notes">
              <span class="label-text font-medium">Notes <span class="text-base-content/40">(optional)</span></span>
            </label>
            <textarea id="req-notes" name="notes" rows="3"
                      placeholder="e.g. Meet at venue 30 mins early, bring full kit"
                      class="textarea textarea-bordered w-full focus:textarea-secondary transition-colors"
                      maxlength="2000">{{ values.notes or '' }}</textarea>
          </div>

          <!-- Actions -->
          <div class="flex gap-3 pt-2">
            <a href="/dashboard/availability" class="btn btn-ghost flex-1">Cancel</a>
            <button type="submit" class="btn btn-secondary flex-1 gap-2 font-semibold" {% if teams.length === 0 %}disabled{% endif %}>
              Send Request
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</section>

<!-- Toggle custom event type field -->
<script nonce="{{ cspNonce }}">
  (function () {
    var typeSelect = document.getElementById('req-request-type');
    var customGroup = document.getElementById('custom-request-type-group');

    function toggleCustom() {
      if (typeSelect.value === 'other') {
        customGroup.style.display = '';
      } else {
        customGroup.style.display = 'none';
      }
    }

    typeSelect.addEventListener('change', toggleCustom);
    toggleCustom(); // run on load for pre-filled forms
  })();
</script>
{% endblock %}
